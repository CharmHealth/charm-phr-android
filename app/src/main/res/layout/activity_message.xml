<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/messageMainLayout"
    android:background="@color/commonBgColor"
    tools:context=".ui.message.MessageActivity">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/messageToolbar"
        android:layout_width="match_parent"
        android:layout_height="?actionBarSize"
        android:background="@color/toolbarBg"
        android:elevation="@dimen/tab_elevation"
        app:contentInsetStart="0dp"
        app:contentInsetStartWithNavigation="0dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">


        <ImageButton
            android:id="@+id/messageBackBtn"
            android:layout_width="@dimen/toolBarBtnWd"
            android:layout_height="match_parent"
            android:layout_gravity="start"
            android:background="?selectableItemBackgroundBorderless"
            android:src="@drawable/ic_arrow_back_white"
            android:transitionName="@string/message_transition_back_btn" />

        <TextView
            android:id="@+id/messageToolbarText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/toolbar_text_left_margin"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/message_str"
            android:textAppearance="@style/toolbarText" />

        <ImageButton
            android:id="@+id/messageDeleteBtn"
            android:layout_width="@dimen/toolBarBtnWd"
            android:layout_height="match_parent"
            android:layout_gravity="end"
            android:background="?selectableItemBackgroundBorderless"
            android:src="@drawable/ic_delete_white"
            android:visibility="gone" />

    </androidx.appcompat.widget.Toolbar>

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/messageTabLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/colorPrimary"
        android:elevation="@dimen/tab_elevation"
        android:textAlignment="center"
        app:layout_behavior="@string/appbar_scrolling_view_behavior"
        app:layout_constraintTop_toBottomOf="@id/messageToolbar"
        app:tabBackground="@drawable/item_ripple_color_primary_bg"
        app:tabGravity="fill"
        app:tabIndicatorColor="@color/tabIndicator"
        app:tabIndicatorHeight="@dimen/tab_indicator_height"
        app:tabMaxWidth="0dp"
        app:tabMinWidth="0dp"
        app:tabMode="fixed"
        app:tabPaddingEnd="10dp"
        app:tabPaddingStart="10dp"
        app:tabSelectedTextColor="@color/tabSelectedTxtColor"
        app:tabTextAppearance="@style/tabText"
        app:tabTextColor="@color/tabTxtColor" />

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/messageViewPager"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="@color/commonBgColor"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/messageTabLayout" />

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/messageComposeBtn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/fab_margin"
        android:src="@drawable/ic_add_white_24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:rippleColor="@android:color/white" />

</androidx.constraintlayout.widget.ConstraintLayout>