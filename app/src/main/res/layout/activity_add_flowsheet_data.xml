<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/addFlowsheetDataRootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/commonBgColor"
    tools:context=".ui.flowsheet.add.AddFlowsheetDataActivity">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/addFlowsheetDataToolbar"
        android:layout_width="match_parent"
        android:layout_height="?actionBarSize"
        android:background="@color/toolbarBg"
        app:contentInsetStart="0dp"
        app:contentInsetStartWithNavigation="0dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">


        <ImageButton
            android:id="@+id/addFlowsheetDataBackBtn"
            android:layout_width="@dimen/toolBarBtnWd"
            android:layout_height="match_parent"
            android:layout_gravity="start"
            android:background="?selectableItemBackgroundBorderless"
            android:src="@drawable/ic_arrow_back_white" />


        <TextView
            android:id="@+id/addFlowsheetDataToolbarText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/toolbar_text_left_margin"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="@string/add_flowsheet_entries_txt"
            android:textAppearance="@style/toolbarText" />

    </androidx.appcompat.widget.Toolbar>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/addFlowsheetDataScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@id/addFlowsheetDataBtn"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/addFlowsheetDataToolbar">

        <LinearLayout
            android:id="@+id/addFlowsheetDataMainLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <androidx.cardview.widget.CardView
                android:id="@+id/addFlowsheetDataObservedOnCardview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/questionnaire_card_margin_horizontal"
                android:layout_marginTop="@dimen/questionnaire_card_margin_horizontal"
                android:layout_marginEnd="@dimen/questionnaire_card_margin_horizontal"
                app:cardCornerRadius="@dimen/common_card_radius"
                app:cardElevation="@dimen/common_card_elevation"

                >

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <ImageView
                        android:id="@+id/addFlowsheetDataObservedOnImg"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/card_padding"
                        android:src="@drawable/ic_calander"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/addFlowsheetDataObservedOnLabel"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/card_padding"
                        android:layout_marginTop="@dimen/card_padding"
                        android:layout_marginEnd="@dimen/card_padding"
                        android:fontFamily="@font/open_sans"
                        android:text="@string/allergy_add_observed_on_hint"
                        android:textColor="@color/black87"
                        android:textSize="@dimen/medium"
                        app:layout_constraintEnd_toStartOf="@id/addFlowsheetDataObservedOnImg"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/addFlowsheetDataObservedOnTV"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/card_padding"
                        android:layout_marginTop="@dimen/common_card_item_margin_vertical"
                        android:layout_marginEnd="@dimen/card_padding"
                        android:layout_marginBottom="@dimen/card_padding"
                        android:fontFamily="@font/open_sans"
                        android:textColor="@android:color/black"
                        android:textSize="@dimen/xx_medium"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toStartOf="@id/addFlowsheetDataObservedOnImg"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/addFlowsheetDataObservedOnLabel"
                        tools:text="@string/allergy_add_observed_on_hint" />

                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>

    </androidx.core.widget.NestedScrollView>


    <Button
        android:id="@+id/addFlowsheetDataBtn"
        style="@style/mdButtonStyle"
        android:layout_width="match_parent"
        android:layout_height="@dimen/add_button_height"
        android:layout_marginStart="@dimen/flowsheet_add_card_margin_horizontal"
        android:layout_marginTop="@dimen/button_margin"
        android:layout_marginEnd="@dimen/flowsheet_add_card_margin_horizontal"
        android:layout_marginBottom="@dimen/button_margin"
        android:background="@drawable/item_button_bg"
        android:fontFamily="@font/open_sans_medium"
        android:text="@string/submit_str"
        android:textColor="@android:color/white"
        android:textSize="@dimen/large"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/addFlowsheetDataScroll" />

</androidx.constraintlayout.widget.ConstraintLayout>