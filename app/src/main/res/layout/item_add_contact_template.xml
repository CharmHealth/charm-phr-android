<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/addContactCardView"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/card_padding"
    android:layout_marginStart="@dimen/common_card_elevation"
    android:layout_marginEnd="@dimen/common_card_elevation"
    android:layout_marginBottom="@dimen/common_card_elevation"
    android:animateLayoutChanges="true"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="@dimen/common_card_radius"
    app:cardElevation="@dimen/common_card_elevation">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/addContactFullNameTV"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/card_margin_horizontal"
            android:layout_marginStart="@dimen/edittext_margin_horizontal"
            android:layout_marginEnd="@dimen/card_padding_half"
            android:fontFamily="@font/open_sans"
            android:text="@string/full_name_str"
            android:textColor="@color/black87"
            android:textSize="@dimen/medium"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"

            />

        <com.charm.phr.mphr.ui.components.MDTextInputEdittext
            android:id="@+id/addContactFullNameET"
            style="@style/itemInputTheme"
            android:layout_width="0dp"
            android:layout_height="@dimen/item_input_height"
            android:layout_marginStart="@dimen/edittext_margin_horizontal"
            android:layout_marginTop="@dimen/edittext_padding"
            android:layout_marginEnd="@dimen/edittext_margin_horizontal"
            android:layout_marginBottom="@dimen/edittext_padding"
            android:background="@drawable/item_edittext_grey_bg"
            android:gravity="center_vertical"
            android:padding="@dimen/card_padding"
            android:maxLength="50"
            android:textColor="@color/edittext_txt_color"
            android:textSize="@dimen/medium"
            app:filterRegex="alphabetsNumbersAndSplChar"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/addContactFullNameTV"
            app:setBgTransparent="false"
            tools:text="Test User" />

        <TextView
            android:id="@+id/addContactEmailTV"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/edittext_margin_horizontal"
            android:layout_marginTop="@dimen/card_margin_horizontal"
            android:layout_marginEnd="@dimen/card_padding_half"
            android:fontFamily="@font/open_sans"
            android:text="@string/save_pat_demo_email_address_str"
            android:textColor="@color/black87"
            android:textSize="@dimen/medium"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/addContactFullNameET" />

        <com.charm.phr.mphr.ui.components.MDTextInputEdittext
            android:id="@+id/addContactEmailET"
            style="@style/itemInputTheme"
            android:layout_width="0dp"
            android:layout_height="@dimen/item_input_height"
            android:layout_marginStart="@dimen/edittext_margin_horizontal"
            android:layout_marginTop="@dimen/edittext_padding"
            android:layout_marginEnd="@dimen/edittext_margin_horizontal"
            android:layout_marginBottom="@dimen/edittext_padding"
            android:background="@drawable/item_edittext_grey_bg"
            android:gravity="center_vertical"
            android:padding="@dimen/card_padding"
            android:textColor="@color/edittext_txt_color"
            android:textSize="@dimen/medium"
            android:maxLength="50"
            app:filterRegex="alphabetsNumbersAndSplChar"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/addContactEmailTV"
            app:setBgTransparent="false"
            tools:text="TestUser@gmail.com" />

        <TextView
            android:id="@+id/addContactRemove"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/edittext_padding"
            android:layout_marginEnd="@dimen/edittext_margin_horizontal"
            android:fontFamily="@font/open_sans_medium"
            android:paddingBottom="@dimen/edittext_padding"
            android:text="@string/remove_str"
            android:textColor="@color/colorPrimary"
            android:textSize="@dimen/medium"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintTop_toBottomOf="@+id/addContactEmailET"

            />
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.cardview.widget.CardView>