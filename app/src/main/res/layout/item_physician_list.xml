<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@android:color/transparent">

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/card_margin_horizontal"
        android:layout_marginTop="@dimen/card_margin_vertical"
        android:layout_marginEnd="@dimen/card_margin_horizontal"
        android:layout_marginBottom="@dimen/card_margin_vertical"
        android:animateLayoutChanges="true"
        app:cardBackgroundColor="@android:color/white"
        app:cardCornerRadius="@dimen/common_card_radius"
        app:cardElevation="@dimen/common_card_elevation">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/physicianConstraintLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/item_ripple_white_bg"
            android:paddingTop="@dimen/card_padding"
            android:paddingBottom="@dimen/card_padding">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/physicianLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <TextView
                    android:id="@+id/physicianNameTV"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="@dimen/card_padding"
                    android:paddingEnd="@dimen/card_padding"
                    android:textAppearance="@style/nameHPDisplayTxtAppearance"
                    app:layout_constraintEnd_toStartOf="@id/physicianMobileImg"
                    app:layout_constraintHorizontal_bias="0"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    tools:text="Hypertension" />

                <TextView
                    android:id="@+id/physicianMobileTV"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/common_card_item_margin_vertical"
                    android:fontFamily="@font/open_sans"
                    android:paddingStart="@dimen/card_padding"
                    android:paddingEnd="@dimen/card_padding"
                    android:textColor="@color/black87"
                    android:textSize="@dimen/xx_small"
                    app:layout_constraintEnd_toStartOf="@id/physicianMobileImg"
                    app:layout_constraintHorizontal_bias="0"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/physicianNameTV"
                    tools:text="9876543234" />

                <ImageView
                    android:id="@+id/physicianMobileImg"
                    android:layout_width="wrap_content"
                    android:layout_height="0dp"
                    android:paddingStart="0dp"
                    android:paddingEnd="@dimen/card_padding"
                    android:src="@drawable/ic_phone"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>
</FrameLayout>