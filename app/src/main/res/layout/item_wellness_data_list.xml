<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <TextView
        android:id="@+id/wellnessDataSubHeading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/card_padding"
        android:layout_marginTop="@dimen/card_margin_horizontal"
        android:fontFamily="@font/open_sans_medium"
        android:textColor="@color/black56"
        android:textSize="@dimen/xx_small"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="Vitals" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/wellnessDataInnerRV"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="@dimen/dashboard_health_rv_vertical_padding"
        android:paddingBottom="@dimen/dashboard_health_rv_vertical_padding"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/wellnessDataSubHeading" />

</androidx.constraintlayout.widget.ConstraintLayout>