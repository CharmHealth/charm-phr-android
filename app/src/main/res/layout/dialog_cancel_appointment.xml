<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cancelAppDialogLayout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    app:cardCornerRadius="20dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <TextView
            android:id="@+id/cancelAppointmentHeadingTV"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dialog_heading_half_margin"
            android:layout_marginTop="@dimen/dialog_heading_half_margin"
            android:layout_marginEnd="@dimen/dialog_heading_half_margin"
            android:text="@string/cancel_appointment_str"
            android:textAppearance="@style/appointmentCardHeading"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />


        <TextView
            android:id="@+id/cancelAppointmentMsgText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dialog_heading_half_margin"
            android:layout_marginTop="@dimen/dialog_heading_half_margin"
            android:layout_marginEnd="@dimen/dialog_heading_half_margin"
            android:fontFamily="@font/open_sans"
            android:text="@string/cancel_appointment_msg_str"
            android:textColor="@color/black87"
            android:textSize="@dimen/medium"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/cancelAppointmentHeadingTV" />

        <LinearLayout
            android:id="@+id/cancelAppProfilePicLL"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/cancelAppointmentMsgText">

            <de.hdodenhof.circleimageview.CircleImageView
                android:id="@+id/cancelAppProfilePic"
                android:layout_width="@dimen/message_detail_sent_member_image_size"
                android:layout_height="@dimen/message_detail_sent_member_image_size"
                android:layout_marginStart="@dimen/dialog_heading_half_margin"
                android:layout_marginTop="@dimen/dialog_subheading_margin"
                android:src="@drawable/ic_patient_male_dummy" />

            <TextView
                android:id="@+id/cancelAppProfileDummyTV"
                style="@style/genderOtherTxtStyle"
                android:layout_width="@dimen/message_detail_sent_member_image_size"
                android:layout_height="@dimen/message_detail_sent_member_image_size"
                android:layout_marginStart="@dimen/dialog_heading_half_margin"
                android:layout_marginTop="@dimen/card_margin_patient_list_horizontal"
                android:visibility="gone" />

        </LinearLayout>

        <TextView
            android:id="@+id/cancelAppMemberTxtView"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dialog_subheading_margin"
            android:ellipsize="end"
            android:fontFamily="@font/open_sans_medium"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:paddingStart="@dimen/card_padding"
            android:paddingEnd="@dimen/card_padding"
            android:textColor="@color/black87"
            android:textSize="@dimen/medium"
            app:layout_constraintEnd_toStartOf="@+id/cancelAppMeetingTypeLL"
            app:layout_constraintStart_toEndOf="@+id/cancelAppProfilePicLL"
            app:layout_constraintTop_toBottomOf="@+id/cancelAppointmentMsgText"
            tools:text="Dr. Johnathan Smith" />

        <TextView
            android:id="@+id/cancelAppProviderTxtView"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/common_card_item_margin_vertical"
            android:ellipsize="end"
            android:fontFamily="@font/open_sans"
            android:maxLines="1"
            android:paddingStart="@dimen/card_padding"
            android:paddingEnd="@dimen/card_padding"
            android:textColor="@color/black87"
            android:textSize="@dimen/xx_small"
            app:layout_constraintEnd_toStartOf="@+id/cancelAppMeetingTypeLL"
            app:layout_constraintStart_toEndOf="@+id/cancelAppProfilePicLL"
            app:layout_constraintTop_toBottomOf="@id/cancelAppMemberTxtView"
            tools:text="Malar Hospital" />

        <com.charm.phr.mphr.ui.components.MDmPHRConstraintLayout
            android:id="@+id/cancelAppMeetingTypeLL"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:layout_margin="@dimen/card_padding"
            android:paddingStart="@dimen/dashboard_card_margin"
            android:paddingTop="2dp"
            android:paddingEnd="@dimen/dialog_heading_half_margin"
            android:paddingBottom="2dp"
            app:layout_constraintBottom_toBottomOf="@+id/cancelAppProfilePicLL"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/cancelAppProfilePicLL"
            app:mdCornerRadius="@dimen/card_radius">

            <ImageView
                android:id="@+id/cancelAppMeetingTypeIV"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_call"
                app:layout_constraintBottom_toBottomOf="@+id/cancelAppMeetingTypeTxtView"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@+id/cancelAppMeetingTypeTxtView" />

            <TextView
                android:id="@+id/cancelAppMeetingTypeTxtView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/card_padding_half"
                android:fontFamily="@font/open_sans_medium"
                android:textColor="@color/black87"
                android:textSize="@dimen/xx_small"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@+id/cancelAppMeetingTypeIV"
                app:layout_constraintTop_toTopOf="parent"
                tools:text="In Person" />
        </com.charm.phr.mphr.ui.components.MDmPHRConstraintLayout>

        <androidx.cardview.widget.CardView
            android:id="@+id/cancelAppCalenderCV"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dialog_heading_half_margin"
            android:layout_marginTop="@dimen/common_margin_vertical"
            android:layout_marginEnd="@dimen/dialog_heading_half_margin"
            app:cardCornerRadius="8dp"
            app:cardElevation="0dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/cancelAppProfilePicLL">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cancelAppCalenderCL"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/darkBlue_trans06"
                android:padding="@dimen/card_padding">

                <ImageView
                    android:id="@+id/cancelAppCalenderIV"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/ic_calender_appointment"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/cancelAppDateTv"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/open_sans_medium"
                    android:paddingStart="@dimen/card_padding_half"
                    android:paddingEnd="@dimen/card_padding"
                    android:textColor="@color/black87"
                    android:textSize="@dimen/medium"
                    app:layout_constraintBottom_toBottomOf="@+id/cancelAppCalenderIV"
                    app:layout_constraintStart_toEndOf="@+id/cancelAppCalenderIV"
                    app:layout_constraintTop_toTopOf="@+id/cancelAppCalenderIV"
                    app:layout_constraintVertical_bias="1.0"
                    tools:text="Mon, Aug 31" />

                <TextView
                    android:id="@+id/cancelAppDayTv"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="@font/open_sans"
                    android:paddingStart="@dimen/card_padding_half"
                    android:paddingEnd="@dimen/card_padding"
                    android:textColor="@color/black87"
                    android:textSize="@dimen/small"
                    app:layout_constraintStart_toEndOf="@+id/cancelAppCalenderIV"
                    app:layout_constraintTop_toBottomOf="@+id/cancelAppDateTv"
                    tools:text="Monday" />

                <TextView
                    android:id="@+id/cancelAppTimeZoneTv"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:fontFamily="@font/open_sans"
                    android:paddingStart="@dimen/card_padding_half"
                    android:textColor="@color/black87"
                    android:textSize="@dimen/small"
                    android:visibility="visible"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/cancelAppDateTv"
                    tools:text="(US/Pacific) sdfsdsff sdfsd" />

                <TextView
                    android:id="@+id/cancelAppTimeTv"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/open_sans_medium"
                    android:textColor="@color/black87"
                    android:textSize="@dimen/medium"
                    app:layout_constraintBottom_toBottomOf="@+id/cancelAppTimeIV"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@+id/cancelAppTimeIV"
                    tools:text="09:15 AM" />

                <ImageView
                    android:id="@+id/cancelAppTimeIV"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/ic_time"
                    app:layout_constraintBottom_toBottomOf="@+id/cancelAppCalenderIV"
                    app:layout_constraintEnd_toStartOf="@+id/cancelAppTimeTv"
                    app:layout_constraintTop_toTopOf="@+id/cancelAppCalenderIV" />
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.cardview.widget.CardView>

        <TextView
            android:id="@+id/appointmentCancelReason"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dialog_heading_half_margin"
            android:layout_marginTop="@dimen/dialog_subheading_margin"
            android:fontFamily="@font/open_sans_medium"
            android:text="@string/reason_cancel_appointment_str"
            android:textColor="@color/black87"
            android:textSize="@dimen/medium"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/cancelAppCalenderCV" />

        <com.charm.phr.mphr.ui.components.MDTextInputEdittext
            android:id="@+id/appointmentCancelReasonET"
            android:layout_width="match_parent"
            android:layout_height="@dimen/flowsheet_add_ques_ans_value_min_height"
            android:layout_marginStart="@dimen/dialog_heading_half_margin"
            android:layout_marginTop="@dimen/common_margin_vertical"
            android:layout_marginEnd="@dimen/dialog_heading_half_margin"
            android:background="@drawable/item_add_flowsheet_et_bg"
            android:fontFamily="@font/open_sans"
            android:gravity="start|top"
            android:inputType="text|textCapSentences|textNoSuggestions|textMultiLine"
            android:padding="@dimen/questionnaire_detail_ques_ans_value_padding"
            android:textColor="@color/edittext_txt_color"
            android:textSize="@dimen/medium"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/appointmentCancelReason"
            app:setBgTransparent="false"
            tools:text="10 times per month" />

        <Button
            android:id="@+id/cancelAppButton"
            android:layout_width="match_parent"
            android:layout_height="@dimen/add_button_height"
            android:layout_margin="@dimen/dialog_heading_half_margin"
            android:background="@drawable/item_button_bg"
            android:fontFamily="@font/open_sans_medium"
            android:letterSpacing="0"
            android:text="@string/confirm_cancel_appointment_str"
            android:textAllCaps="false"
            android:textColor="@color/textColorForColorPrimaryBg"
            android:textSize="@dimen/xx_medium"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/appointmentCancelReasonET" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.cardview.widget.CardView>