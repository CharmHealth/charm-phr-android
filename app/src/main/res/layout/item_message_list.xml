<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@android:color/transparent">

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/card_margin_horizontal"
        android:layout_marginTop="@dimen/card_margin_vertical"
        android:layout_marginEnd="@dimen/card_margin_horizontal"
        android:layout_marginBottom="@dimen/card_margin_vertical"
        app:cardBackgroundColor="@android:color/white"
        app:cardCornerRadius="@dimen/common_card_radius"
        app:cardElevation="@dimen/common_card_elevation">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/messageListConstrainLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/item_ripple_white_bg">

            <TextView
                android:id="@+id/messageListSubjectTV"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/card_padding"
                android:ellipsize="end"
                android:fontFamily="@font/open_sans"
                android:maxLines="1"
                android:paddingStart="@dimen/card_padding"
                android:paddingEnd="@dimen/card_padding"
                android:textColor="@color/messageListSubjectTxtColor"
                android:textSize="@dimen/x_medium"
                android:transitionName="@string/message_transition_subject"
                app:layout_constraintEnd_toStartOf="@id/messageListDateTV"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:text="Charm Multispeciality" />

            <TextView
                android:id="@+id/messageListDateTV"
                android:layout_width="@dimen/message_list_date_width"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/card_padding"
                android:layout_marginEnd="@dimen/card_padding"
                android:fontFamily="@font/open_sans_medium"
                android:gravity="end"
                android:textColor="@color/messageListDateTxtColor"
                android:textSize="@dimen/small"
                app:layout_constraintBottom_toBottomOf="@id/messageListSubjectTV"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:text="May 20 ,2000" />

            <TextView
                android:id="@+id/messageListFromOrToTV"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/message_list_subject_top_margin"
                android:layout_marginBottom="@dimen/card_padding"
                android:fontFamily="@font/open_sans"
                android:paddingStart="@dimen/card_padding"
                android:paddingEnd="@dimen/card_padding"
                android:textColor="@color/messageListFromOrToTxtColor"
                android:textSize="@dimen/xx_small"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="@id/messageListSubjectTV"
                app:layout_constraintStart_toStartOf="@id/messageListSubjectTV"
                app:layout_constraintTop_toBottomOf="@id/messageListSubjectTV"
                tools:text="Dr. William Aberthnet" />

            <ImageView
                android:id="@+id/messageListAttachmentIcon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/card_padding"
                android:layout_marginBottom="@dimen/card_padding"
                android:src="@drawable/ic_attach_file_primary"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/messageListDateTV"
                app:layout_constraintVertical_bias="1" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>
</FrameLayout>