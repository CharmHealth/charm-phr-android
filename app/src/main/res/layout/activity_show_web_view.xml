<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/easyTeleMainLayout"
    tools:context=".ui.appointment.book_appointment.easytelecare.EasyTeleBookAppointmentActivity">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/bookAppointmentToolbar"
        android:layout_width="match_parent"
        android:layout_height="?actionBarSize"
        android:background="@color/toolbarBg"
        android:clickable="true"
        android:focusable="true"
        android:focusableInTouchMode="true"
        app:contentInsetStart="0dp"
        app:contentInsetStartWithNavigation="0dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/bookAppointmentBackBtn"
            android:layout_width="@dimen/toolBarBtnWd"
            android:layout_height="match_parent"
            android:layout_gravity="start"
            android:background="?selectableItemBackgroundBorderless"
            android:src="@drawable/ic_arrow_back_white" />

        <TextView
            android:id="@+id/bookAppointmentToolbarText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/toolbar_text_left_margin"
            android:text="@string/book_appointment_str"
            android:textAppearance="@style/toolbarText" />

        <ImageButton
            android:id="@+id/bookAppCloseBtn"
            android:layout_width="@dimen/toolBarBtnWd"
            android:layout_height="match_parent"
            android:layout_gravity="end"
            android:background="?selectableItemBackgroundBorderless"
            android:src="@drawable/ic_close_white" />

    </androidx.appcompat.widget.Toolbar>

    <WebView
        android:id="@+id/bookAppointmentWebView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:paddingStart="@dimen/message_compose_items_padding_horizontal"
        android:paddingEnd="@dimen/message_compose_items_padding_horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/bookAppointmentToolbar" />

    <include
        android:id="@+id/bookAppointmentProgress"
        layout="@layout/progress_bar_for_white_bg" />

</androidx.constraintlayout.widget.ConstraintLayout>