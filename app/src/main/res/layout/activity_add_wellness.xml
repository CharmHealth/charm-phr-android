<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/addWellnessRootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/commonBgColor"
    tools:context=".ui.wellness.addWellness.AddWellnessActivity">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/addWellnessToolbar"
        android:layout_width="match_parent"
        android:layout_height="?actionBarSize"
        android:background="@color/toolbarBg"
        app:contentInsetStart="0dp"
        app:contentInsetStartWithNavigation="0dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">


        <ImageButton
            android:id="@+id/addWellnessBackBtn"
            android:layout_width="@dimen/toolBarBtnWd"
            android:layout_height="match_parent"
            android:layout_gravity="start"
            android:background="?selectableItemBackgroundBorderless"
            android:src="@drawable/ic_arrow_back_white" />

        <TextView
            android:id="@+id/addWellnessToolbarText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/toolbar_text_left_margin"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:textAppearance="@style/toolbarText" />

    </androidx.appcompat.widget.Toolbar>

    <ScrollView
        android:id="@+id/addWellnessScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"

        app:layout_constraintBottom_toTopOf="@id/addWellnessBtn"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/addWellnessToolbar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:background="@android:color/white">

                <ImageView
                    android:id="@+id/addWellnessPrevDateBtn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/common_margin_horizontal"
                    android:background="@drawable/item_ripple_color_primary_bg"
                    android:src="@drawable/ic_wellness_arrow_left"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:tint="@color/img_date_arrow_tint" />

                <TextView
                    android:id="@+id/addWellnessDateET"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/open_sans_medium"
                    android:textColor="@color/black87"
                    android:textSize="@dimen/xx_medium"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/addWellnessNextDateBtn"
                    app:layout_constraintStart_toEndOf="@id/addWellnessPrevDateBtn"
                    app:layout_constraintTop_toTopOf="parent"
                    tools:text="Fri, Nov 1, 2019" />

                <ImageView
                    android:id="@+id/addWellnessNextDateBtn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/common_margin_horizontal"
                    android:background="@drawable/item_ripple_color_primary_bg"
                    android:src="@drawable/ic_wellness_arrow_right"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:tint="@color/img_date_arrow_tint" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <com.charm.phr.mphr.ui.components.MDTextInputLayout
                android:id="@+id/addWellnessTimeLayout"
                style="@style/itemTextInputLayoutTheme"
                android:layout_marginTop="@dimen/card_padding"
                app:hintTextAppearance="@style/itemEdittextHintTxtAppearance"
                app:mdShowDropdown="false">

                <com.charm.phr.mphr.ui.components.MDTextInputEdittext
                    android:id="@+id/addWellnessTimeET"
                    style="@style/itemTextInputEdittextTheme"
                    android:drawableEnd="@drawable/ic_clock"
                    android:hint="@string/time_str" />

            </com.charm.phr.mphr.ui.components.MDTextInputLayout>

            <androidx.cardview.widget.CardView
                android:id="@+id/addWellnessSelectParamLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/edittext_margin_horizontal"
                android:layout_marginTop="@dimen/card_padding"

                android:layout_marginEnd="@dimen/xx_small"
                app:cardCornerRadius="@dimen/common_card_radius"
                app:cardElevation="@dimen/common_card_elevation">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        android:id="@+id/addWellnessSelectParamHeadingTV"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/edittext_padding"
                        android:layout_marginTop="@dimen/edittext_padding"
                        android:fontFamily="@font/open_sans_medium"
                        android:text="@string/select_parameters_txt"
                        android:textColor="@color/black87"
                        android:textSize="@dimen/xx_small"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <View
                        android:id="@+id/addWellnessSelectParamSeparator"
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="@dimen/edittext_padding"
                        android:background="#1A707070"
                        app:layout_constraintTop_toBottomOf="@id/addWellnessSelectParamHeadingTV" />

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/addWellnessChipGrp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingStart="@dimen/edittext_padding"

                        android:paddingEnd="@dimen/edittext_padding"
                        app:layout_constraintTop_toBottomOf="@id/addWellnessSelectParamSeparator"

                        >

                    </com.google.android.material.chip.ChipGroup>

                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.cardview.widget.CardView>

            <LinearLayout
                android:id="@+id/addWellnessMainLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

            </LinearLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/addWellnessNotesLayout"
                style="@style/itemTextInputLayoutTheme"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/card_padding"
                android:layout_marginBottom="@dimen/card_padding"
                android:minHeight="@dimen/textinput_edittext_height"
                app:helperTextTextAppearance="@style/itemEdittextHelperTxtAppearance"
                app:hintTextAppearance="@style/itemEdittextHintTxtAppearance">

                <com.charm.phr.mphr.ui.components.MDTextInputEdittext
                    android:id="@+id/addWellnessNotesET"
                    style="@style/itemTextInputEdittextMultiLineTheme"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/wellness_notes_hint"
                    android:maxLength="@integer/addAllergyReactionsMaxLength" />
            </com.google.android.material.textfield.TextInputLayout>

        </LinearLayout>
    </ScrollView>


    <include
        android:id="@+id/addWellnessProgress"
        layout="@layout/progress_bar_for_white_bg"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/addWellnessToolbar" />

    <include
        android:id="@+id/addWellnessErrorPage"
        layout="@layout/layout_error_page"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/addWellnessToolbar" />

    <Button
        style="@style/mdButtonStyle"
        android:id="@+id/addWellnessBtn"
        android:layout_width="match_parent"
        android:layout_height="@dimen/add_button_height"
        android:layout_margin="@dimen/button_margin"
        android:background="@drawable/item_button_bg"
        android:fontFamily="@font/open_sans_medium"
        android:text="@string/record"
        android:textColor="@android:color/white"
        android:textSize="@dimen/large"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/addWellnessScroll"
        app:layout_constraintVertical_bias="1" />

</androidx.constraintlayout.widget.ConstraintLayout>