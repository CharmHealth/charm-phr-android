<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/dashboard_card_padding"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical"
    android:paddingStart="@dimen/dashboard_card_padding"
    android:paddingEnd="@dimen/dashboard_card_padding">

    <de.hdodenhof.circleimageview.CircleImageView
        android:id="@+id/recentMessageProfilePic"
        android:layout_width="@dimen/message_detail_sent_member_image_size"
        android:layout_height="@dimen/message_detail_sent_member_image_size"
        android:layout_marginTop="3dp"
        android:src="@drawable/ic_patient_male_dummy"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/recentMessageProfileDummyTV"
        style="@style/genderOtherTxtStyle"
        android:layout_width="@dimen/message_detail_sent_member_image_size"
        android:layout_height="@dimen/message_detail_sent_member_image_size"
        android:layout_marginTop="3dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />


    <TextView
        android:id="@+id/recentMessageDateTV"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:layout_marginBottom="5dp"
        android:gravity="top"
        android:paddingStart="@dimen/dashboard_card_padding"
        android:paddingEnd="0dp"
        android:textAppearance="@style/dateDisplayTxtAppearance"
        android:visibility="visible"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="May 10 , 1990" />

    <TextView
        android:id="@+id/recentMessageMemberNameTV"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:fontFamily="@font/open_sans_medium"
        android:maxLines="2"
        android:paddingStart="@dimen/dashboard_card_padding"
        android:paddingEnd="@dimen/dashboard_card_padding"
        android:textColor="@color/black87"
        android:textSize="@dimen/xx_small"
        app:layout_constraintEnd_toStartOf="@id/recentMessageDateTV"
        app:layout_constraintStart_toEndOf="@id/recentMessageProfilePic"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="Dr. Angela Smith" />

    <TextView
        android:id="@+id/recentMessageSubjectTV"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/common_card_item_margin_vertical"
        android:fontFamily="@font/open_sans"
        android:paddingStart="@dimen/dashboard_card_padding"
        android:paddingEnd="0dp"
        android:letterSpacing="0.005"
        android:textColor="@color/black87"
        android:textSize="@dimen/x_small"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/recentMessageProfilePic"
        app:layout_constraintTop_toBottomOf="@id/recentMessageMemberNameTV"
        tools:text="1 tablet once a day at bedtime before meals" />


</androidx.constraintlayout.widget.ConstraintLayout>