<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/addCofMainLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/item_book_appointment_card_details_bg">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/addCofToolbar"
        android:layout_width="match_parent"
        android:layout_height="?actionBarSize"
        android:background="@color/toolbarBg"
        app:contentInsetStart="0dp"
        app:contentInsetStartWithNavigation="0dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/addCofBackBtn"
            android:layout_width="@dimen/toolBarBtnWd"
            android:layout_height="match_parent"
            android:layout_gravity="start"
            android:background="?selectableItemBackgroundBorderless"
            android:src="@drawable/ic_arrow_back_white" />

        <TextView
            android:id="@+id/addCofToolbarText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/toolbar_text_left_margin"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:text="@string/card_add_str"
            android:textAppearance="@style/toolbarText" />

    </androidx.appcompat.widget.Toolbar>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginBottom="@dimen/common_margin_horizontal"
        app:layout_constraintBottom_toTopOf="@+id/addCofBtn"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/addCofToolbar">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/common_margin_vertical">

            <TextView
                android:id="@+id/addCofPracticeTV"
                style="@style/itemEdittextHeadingTheme"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/choose_practice"
                app:layout_constraintBottom_toTopOf="@+id/addCofPracticeLayout"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <com.charm.phr.mphr.ui.components.MDTextInputLayout
                android:id="@+id/addCofPracticeLayout"
                style="@style/itemTextInputLayoutTheme"
                app:hintTextAppearance="@style/itemEdittextHintTxtAppearance"
                app:layout_constraintBottom_toTopOf="@+id/addCofCardDetailsTV"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/addCofPracticeTV">

                <com.charm.phr.mphr.ui.components.MDClickToSelectEdittext
                    android:id="@+id/addCofPracticeET"
                    style="@style/itemTextInputEdittextTheme"
                    android:hint="@string/practice_only_str" />

            </com.charm.phr.mphr.ui.components.MDTextInputLayout>

            <TextView
                android:id="@+id/addCofCardDetailsTV"
                style="@style/itemEdittextHeadingTheme"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/book_appointment_card_detail_str"
                app:layout_constraintBottom_toTopOf="@+id/addCofCardDetailsCV"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/addCofPracticeLayout" />

            <androidx.cardview.widget.CardView
                android:id="@+id/addCofCardDetailsCV"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/edittext_margin_horizontal"
                android:layout_marginTop="@dimen/edittext_margin_vertical"
                android:layout_marginEnd="@dimen/edittext_margin_horizontal"
                android:layout_marginBottom="@dimen/edittext_margin_vertical"
                app:layout_constraintBottom_toTopOf="@+id/addCofPrimaryCardCheckbox"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/addCofCardDetailsTV">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/card_padding_half"
                    android:layout_marginBottom="@dimen/card_padding_half">

                    <com.charm.phr.mphr.ui.components.MDTextInputEdittext
                        android:id="@+id/addCofCardNameET"
                        style="@style/itemCardDetailEdittextTheme"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/book_appointment_card_details_height"
                        android:layout_marginStart="@dimen/card_padding"
                        android:layout_marginTop="@dimen/card_padding_half"
                        android:layout_marginEnd="@dimen/card_padding"
                        android:layout_marginBottom="@dimen/card_padding_half"
                        android:hint="@string/payment_card_name_hint"
                        android:imeOptions="actionNext"
                        android:inputType="text|textNoSuggestions|textCapWords"
                        android:maxLines="1"
                        app:layout_constraintBottom_toTopOf="@+id/addCofCardNumberET"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:setBgTransparent="false" />

                    <com.charm.phr.mphr.ui.components.MDTextInputEdittext
                        android:id="@+id/addCofCardNumberET"
                        style="@style/itemCardDetailEdittextTheme"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/book_appointment_card_details_height"
                        android:layout_marginStart="@dimen/card_padding"
                        android:layout_marginTop="@dimen/card_padding_half"
                        android:layout_marginEnd="@dimen/card_padding"
                        android:layout_marginBottom="@dimen/card_padding_half"
                        android:hint="@string/payment_card_number_hint"
                        android:inputType="number"
                        android:maxLength="19"
                        app:layout_constraintBottom_toTopOf="@+id/addCofCardNickNameET"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/addCofCardNameET"
                        app:setBgTransparent="false" />

                    <com.charm.phr.mphr.ui.components.MDTextInputEdittext
                        android:id="@+id/addCofCardNickNameET"
                        style="@style/itemCardDetailEdittextTheme"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/book_appointment_card_details_height"
                        android:layout_marginStart="@dimen/card_padding"
                        android:layout_marginTop="@dimen/card_padding_half"
                        android:layout_marginEnd="@dimen/card_padding"
                        android:layout_marginBottom="@dimen/card_padding_half"
                        android:hint="@string/card_nick_name"
                        android:imeOptions="actionNext"
                        android:inputType="text|textNoSuggestions|textCapWords"
                        android:maxLines="1"
                        app:layout_constraintBottom_toTopOf="@+id/addCofCardExpiryLayout"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/addCofCardNumberET"
                        app:setBgTransparent="false" />

                    <LinearLayout
                        android:id="@+id/addCofCardExpiryLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingTop="@dimen/card_padding_half"
                        android:paddingBottom="@dimen/card_padding_half"
                        android:weightSum="2"
                        app:layout_constraintBottom_toTopOf="@+id/addCofCardCvvET"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/addCofCardNickNameET">

                        <com.charm.phr.mphr.ui.components.MDClickToSelectEdittext
                            android:id="@+id/addCofCardExpMonthET"
                            style="@style/itemCardDetailEdittextTheme"
                            android:layout_width="0dp"
                            android:layout_height="@dimen/book_appointment_card_details_height"
                            android:layout_marginStart="@dimen/card_padding"
                            android:layout_marginEnd="@dimen/card_padding"
                            android:layout_weight="1"
                            android:hint="@string/payment_card_expiry_month_hint"
                            android:inputType="number"
                            app:setBgTransparent="false" />

                        <com.charm.phr.mphr.ui.components.MDClickToSelectEdittext
                            android:id="@+id/addCofCardExpYearET"
                            style="@style/itemCardDetailEdittextTheme"
                            android:layout_width="0dp"
                            android:layout_height="@dimen/book_appointment_card_details_height"
                            android:layout_marginEnd="@dimen/card_padding"
                            android:layout_weight="1"
                            android:hint="@string/payment_card_expiry_year_hint"
                            android:inputType="number"
                            app:setBgTransparent="false" />
                    </LinearLayout>

                    <com.charm.phr.mphr.ui.components.MDTextInputEdittext
                        android:id="@+id/addCofCardCvvET"
                        style="@style/itemCardDetailEdittextTheme"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/book_appointment_card_details_height"
                        android:layout_marginStart="@dimen/card_padding"
                        android:layout_marginTop="@dimen/card_padding_half"
                        android:layout_marginEnd="@dimen/card_padding"
                        android:layout_marginBottom="@dimen/card_padding_half"
                        android:hint="@string/payment_card_cvv_hint"
                        android:imeOptions="actionDone"
                        android:inputType="number"
                        android:maxLength="4"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintHorizontal_bias="0"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/addCofCardExpiryLayout"
                        app:layout_constraintWidth_percent=".464"
                        app:setBgTransparent="false" />
                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.cardview.widget.CardView>

            <CheckBox
                android:id="@+id/addCofPrimaryCardCheckbox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/card_padding"
                android:layout_marginTop="@dimen/edittext_margin_vertical"
                android:layout_marginEnd="@dimen/edittext_margin_horizontal"
                android:layout_marginBottom="@dimen/edittext_margin_vertical"
                android:fontFamily="@font/open_sans"
                android:text="@string/make_this_as_primary_card"
                android:textColor="@color/black87"
                android:textSize="@dimen/medium"
                app:layout_constraintBottom_toTopOf="@+id/addCofAddressCL"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.0"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/addCofCardDetailsCV" />

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/addCofAddressCL"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/addCofPrimaryCardCheckbox">

                <TextView
                    android:id="@+id/addCofAddressTV"
                    style="@style/itemEdittextHeadingTheme"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/pat_demo_address_txt"
                    app:layout_constraintBottom_toTopOf="@+id/addCofLine1Layout"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/addCofLine1Layout"
                    style="@style/itemTextInputLayoutTheme"
                    app:hintTextAppearance="@style/itemEdittextHintTxtAppearance"
                    app:layout_constraintBottom_toTopOf="@id/addCofLine2Layout"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/addCofAddressTV">

                    <com.charm.phr.mphr.ui.components.MDTextInputEdittext
                        android:id="@+id/addCofLine1ET"
                        style="@style/itemTextInputEdittextTheme"
                        android:hint="@string/save_pat_demo_address_line_1"
                        android:maxLength="@integer/savePatientAddressMaxLength"
                        app:filterRegex="alphabetsNumbersAndSplChar"
                        tools:text="Demo" />

                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/addCofLine2Layout"
                    style="@style/itemTextInputLayoutTheme"
                    android:maxLength="@integer/savePatientAddressMaxLength"
                    app:hintTextAppearance="@style/itemEdittextHintTxtAppearance"
                    app:layout_constraintBottom_toTopOf="@id/addCofCityLayout"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/addCofLine1Layout">

                    <com.charm.phr.mphr.ui.components.MDTextInputEdittext
                        android:id="@+id/addCofLine2ET"
                        style="@style/itemTextInputEdittextTheme"
                        android:hint="@string/save_pat_demo_address_line_2"
                        app:filterRegex="alphabetsNumbersAndSplChar"
                        tools:text="Demo" />

                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/addCofCityLayout"
                    style="@style/itemTextInputLayoutTheme"
                    app:hintTextAppearance="@style/itemEdittextHintTxtAppearance"
                    app:layout_constraintBottom_toTopOf="@id/addCofCountryLayout"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/addCofLine2Layout">

                    <com.charm.phr.mphr.ui.components.MDTextInputEdittext
                        android:id="@+id/addCofCityET"
                        style="@style/itemTextInputEdittextTheme"
                        android:hint="@string/save_pat_demo_city_str"
                        android:maxLength="@integer/savePatientCityMaxLength"
                        app:filterRegex="alphabetsNumbersAndSplChar"
                        tools:text="Demo" />

                </com.google.android.material.textfield.TextInputLayout>

                <com.charm.phr.mphr.ui.components.MDTextInputLayout
                    android:id="@+id/addCofCountryLayout"
                    style="@style/itemTextInputLayoutTheme"
                    app:hintTextAppearance="@style/itemEdittextHintTxtAppearance"
                    app:layout_constraintBottom_toTopOf="@id/addCofStateLayout"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/addCofCityLayout">

                    <com.charm.phr.mphr.ui.components.MDTextInputAutoCompleteTextView
                        android:id="@+id/addCofCountryET"
                        style="@style/itemTextInputEdittextTheme"
                        android:hint="@string/save_pat_demo_country_str"
                        app:filterRegex="alphabetsNumbersAndSplChar" />

                </com.charm.phr.mphr.ui.components.MDTextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/addCofStateLayout"
                    style="@style/itemTextInputLayoutTheme"
                    app:hintTextAppearance="@style/itemEdittextHintTxtAppearance"
                    app:layout_constraintBottom_toTopOf="@id/addCofPinCodeLayout"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/addCofCountryLayout">

                    <com.charm.phr.mphr.ui.components.MDTextInputEdittext
                        android:id="@+id/addCofStateET"
                        style="@style/itemTextInputEdittextTheme"
                        android:hint="@string/save_pat_demo_state_str"
                        android:maxLength="2"
                        app:filterRegex="alphabetsNumbersAndSplChar"
                        tools:text="Demo" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/addCofPinCodeLayout"
                    style="@style/itemTextInputLayoutTheme"
                    app:hintTextAppearance="@style/itemEdittextHintTxtAppearance"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/addCofStateLayout">

                    <com.charm.phr.mphr.ui.components.MDTextInputEdittext
                        android:id="@+id/addCofPinCodeET"
                        style="@style/itemTextInputEdittextTheme"
                        android:hint="@string/save_pat_demo_zip_code_str"
                        android:maxLength="10"
                        app:filterRegex="alphabetsNumbersAndSplChar"
                        tools:text="Demo" />

                </com.google.android.material.textfield.TextInputLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>

    <Button
        style="@style/mdButtonStyle"
        android:id="@+id/addCofBtn"
        android:layout_width="match_parent"
        android:layout_height="@dimen/add_button_height"
        android:layout_margin="@dimen/button_margin"
        android:background="@drawable/item_button_bg"
        android:fontFamily="@font/open_sans_medium"
        android:text="@string/add_str"
        android:textColor="@android:color/white"
        android:textSize="@dimen/xx_large"
        app:layout_constraintBottom_toTopOf="@+id/updateCofBtn"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <Button
        style="@style/mdButtonStyle"
        android:id="@+id/updateCofBtn"
        android:layout_width="match_parent"
        android:layout_height="@dimen/add_button_height"
        android:layout_margin="@dimen/button_margin"
        android:background="@drawable/item_button_bg"
        android:fontFamily="@font/open_sans_medium"
        android:text="@string/update_str"
        android:textColor="@android:color/white"
        android:textSize="@dimen/xx_large"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />


</androidx.constraintlayout.widget.ConstraintLayout>