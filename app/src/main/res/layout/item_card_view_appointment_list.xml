<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@android:color/transparent">

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dashboard_card_margin"
        android:layout_marginTop="@dimen/dashboard_health_vertical_margin"
        android:layout_marginEnd="@dimen/dashboard_card_margin"
        android:layout_marginBottom="@dimen/dashboard_health_vertical_margin"
        app:cardBackgroundColor="@android:color/white"
        app:cardCornerRadius="@dimen/card_radius"
        app:cardElevation="@dimen/common_card_elevation">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/itemAppointmentListMainLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="@dimen/card_padding">

            <LinearLayout
                android:id="@+id/appointmentProfilePicLL"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <de.hdodenhof.circleimageview.CircleImageView
                    android:id="@+id/appointmentProfilePic"
                    android:layout_width="@dimen/message_detail_sent_member_image_size"
                    android:layout_height="@dimen/message_detail_sent_member_image_size"
                    android:layout_marginStart="@dimen/card_padding"
                    android:src="@drawable/ic_patient_male_dummy" />

                <TextView
                    android:id="@+id/appointmentProfileDummyTV"
                    style="@style/genderOtherTxtStyle"
                    android:layout_width="@dimen/message_detail_sent_member_image_size"
                    android:layout_height="@dimen/message_detail_sent_member_image_size"
                    android:layout_marginStart="@dimen/card_padding"
                    android:visibility="gone" />

            </LinearLayout>

            <TextView
                android:id="@+id/appointmentListMemberTxtView"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="@font/open_sans_medium"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:paddingStart="@dimen/card_padding"
                android:paddingEnd="@dimen/card_padding"
                android:textColor="@color/black87"
                android:textSize="@dimen/xx_small"
                app:layout_constraintEnd_toStartOf="@+id/appointmentMeetingTypeLL"
                app:layout_constraintStart_toEndOf="@+id/appointmentProfilePicLL"
                app:layout_constraintTop_toTopOf="parent"
                tools:text="Dr. Johnathan Smith" />

            <TextView
                android:id="@+id/appointmentListProviderTxtView"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/common_card_item_margin_vertical"
                android:ellipsize="end"
                android:fontFamily="@font/open_sans"
                android:letterSpacing="0.005"
                android:maxLines="1"
                android:paddingStart="@dimen/card_padding"
                android:paddingEnd="@dimen/card_padding"
                android:textColor="@color/black87"
                android:textSize="@dimen/x_small"
                app:layout_constraintEnd_toStartOf="@+id/appointmentMeetingTypeLL"
                app:layout_constraintStart_toEndOf="@+id/appointmentProfilePicLL"
                app:layout_constraintTop_toBottomOf="@id/appointmentListMemberTxtView"
                tools:text="Malar Hospital" />


            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/appointmentMeetingTypeLL"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingEnd="@dimen/card_padding"
                app:layout_constraintBottom_toBottomOf="@+id/appointmentProfilePicLL"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@+id/appointmentProfilePicLL">

                <ImageView
                    android:id="@+id/appointmentListMeetingTypeIV"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_call"
                    android:visibility="gone"
                    app:layout_constraintBottom_toBottomOf="@+id/appointmentListMeetingTypeTxtView"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="@+id/appointmentListMeetingTypeTxtView" />

                <TextView
                    android:id="@+id/appointmentListMeetingTypeTxtView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/card_padding_half"
                    android:fontFamily="@font/open_sans_medium"
                    android:textColor="@color/black87"
                    android:textSize="@dimen/xx_small"
                    android:visibility="gone"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@+id/appointmentMoreBtn"
                    app:layout_constraintStart_toEndOf="@+id/appointmentListMeetingTypeIV"
                    app:layout_constraintTop_toTopOf="parent"
                    tools:text="In Person" />

                <com.charm.phr.mphr.ui.components.MDmPHRConstraintLayout
                    android:id="@+id/appointmentListVideoCamLayout"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:layout_margin="@dimen/card_padding"
                    android:paddingStart="@dimen/dashboard_card_margin"
                    android:paddingTop="2dp"
                    android:paddingEnd="@dimen/dashboard_card_margin"
                    android:paddingBottom="2dp"
                    android:visibility="gone"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@+id/appointmentMoreBtn"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:mdBackgroundColor="@color/colorPrimary"
                    app:mdCornerRadius="@dimen/card_radius">

                    <ImageView
                        android:id="@+id/appointmentListVideoCamImg"
                        android:layout_width="15dp"
                        android:layout_height="15dp"
                        android:src="@drawable/ic_video_white"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:layout_marginStart="4dp"
                        android:fontFamily="@font/open_sans_medium"
                        android:gravity="center_vertical"
                        android:text="@string/join_str"
                        android:textColor="@color/textColorForColorPrimaryBg"
                        android:textSize="@dimen/small"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@id/appointmentListVideoCamImg"
                        app:layout_constraintTop_toTopOf="parent" />
                </com.charm.phr.mphr.ui.components.MDmPHRConstraintLayout>

                <androidx.compose.ui.platform.ComposeView
                    android:id="@+id/appointmentMoreBtn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <TextView
                android:id="@+id/appointmentReasonValTxtView"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dashboard_card_padding"
                android:layout_marginTop="@dimen/card_padding"
                android:layout_marginEnd="@dimen/dashboard_card_padding"
                android:ellipsize="end"
                android:fontFamily="@font/open_sans"
                android:maxLines="3"
                android:textColor="@color/black87"
                android:textSize="@dimen/xx_small"
                android:visibility="gone"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/appointmentListProviderTxtView"
                tools:text="Medical check-up and routine examination. dewewedededed" />

            <TextView
                android:id="@+id/appointmentDenyReasonValTxtView"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dashboard_card_padding"
                android:layout_marginTop="@dimen/card_padding"
                android:layout_marginEnd="@dimen/dashboard_card_padding"
                android:ellipsize="end"
                android:fontFamily="@font/open_sans"
                android:maxLines="3"
                android:textColor="@color/black87"
                android:textSize="@dimen/xx_small"
                android:visibility="gone"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/appointmentReasonValTxtView"
                tools:text="Medical check-up and routine examination. dewewedededed" />

            <androidx.cardview.widget.CardView
                android:id="@+id/appointmentListCalenderCV"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/card_padding"
                android:layout_marginTop="@dimen/dashboard_card_padding"
                android:layout_marginEnd="@dimen/card_padding"
                android:layout_marginBottom="@dimen/dashboard_card_padding"
                app:cardCornerRadius="8dp"
                app:cardElevation="0dp"
                app:layout_constraintBottom_toTopOf="@+id/appointmentListFillQuestLL"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/appointmentDenyReasonValTxtView">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/appointmentListCalenderCL"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@color/darkBlue_trans06"
                    android:padding="@dimen/card_padding">

                    <ImageView
                        android:id="@+id/appointmentListCalenderIV"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/ic_calender_appointment"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/appointmentListDateTv"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/open_sans_medium"
                        android:paddingStart="@dimen/card_padding_half"
                        android:paddingEnd="@dimen/card_padding"
                        android:textColor="@color/black87"
                        android:textSize="@dimen/xx_small"
                        app:layout_constraintBottom_toBottomOf="@+id/appointmentListCalenderIV"
                        app:layout_constraintStart_toEndOf="@+id/appointmentListCalenderIV"
                        app:layout_constraintTop_toTopOf="@+id/appointmentListCalenderIV"
                        tools:text="Mon, Aug 31" />

                    <TextView
                        android:id="@+id/appointmentListDayTv"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="@font/open_sans"
                        android:paddingStart="@dimen/card_padding_half"
                        android:paddingEnd="@dimen/card_padding"
                        android:textColor="@color/black87"
                        android:textSize="@dimen/small"
                        app:layout_constraintStart_toEndOf="@+id/appointmentListCalenderIV"
                        app:layout_constraintTop_toBottomOf="@+id/appointmentListDateTv"
                        tools:text="Monday" />

                    <TextView
                        android:id="@+id/appointmentListTimeZoneTv"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:ellipsize="end"
                        android:fontFamily="@font/open_sans"
                        android:paddingStart="@dimen/card_padding_half"
                        android:textColor="@color/black87"
                        android:textSize="@dimen/small"
                        android:visibility="visible"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/appointmentListDateTv"
                        tools:text="(US/Pacific) sdfsdsff sdfsd" />

                    <TextView
                        android:id="@+id/appointmentListTimeTv"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/open_sans_medium"
                        android:textColor="@color/black87"
                        android:textSize="@dimen/xx_small"
                        app:layout_constraintBottom_toBottomOf="@+id/appointmentListTimeIV"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="@+id/appointmentListTimeIV"
                        tools:text="09:15 AM" />

                    <ImageView
                        android:id="@+id/appointmentListTimeIV"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingEnd="@dimen/card_padding_half"
                        android:src="@drawable/ic_time"
                        app:layout_constraintBottom_toBottomOf="@+id/appointmentListCalenderIV"
                        app:layout_constraintEnd_toStartOf="@+id/appointmentListTimeTv"
                        app:layout_constraintTop_toTopOf="@+id/appointmentListCalenderIV" />
                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.cardview.widget.CardView>

            <LinearLayout
                android:id="@+id/appointmentListFillQuestLL"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dashboard_card_padding"
                android:layout_marginBottom="@dimen/dashboard_card_padding"
                android:background="@drawable/ic_ripple_outline_bg"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="@dimen/card_padding"
                android:paddingTop="@dimen/card_padding"
                android:paddingEnd="@dimen/card_padding"
                android:paddingBottom="@dimen/card_padding"
                android:visibility="gone"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/appointmentListCalenderCV">

                <TextView
                    android:id="@+id/appointmentListFillQuestTxtView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/open_sans_medium"
                    android:paddingEnd="@dimen/card_padding_half"
                    android:text="@string/fill_questionnaire_txt"
                    android:textColor="@color/colorTourpage"
                    android:textSize="@dimen/xx_small" />

                <TextView
                    android:id="@+id/appointmentListFillQuestCountTxtView"
                    style="@style/notificationItem"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_gravity="center_vertical"
                    android:background="@drawable/item_count_bg"
                    android:fontFamily="@font/open_sans_medium"
                    android:textColor="@color/colorTourpage"
                    android:textSize="@dimen/tiny"
                    tools:text="2" />
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>
</FrameLayout>