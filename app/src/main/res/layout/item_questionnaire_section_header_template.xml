<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="45dp"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <TextView
        android:id="@+id/quesSectionHeadingTV"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/card_padding"
        android:layout_alignParentStart="true"
        android:fontFamily="@font/open_sans_medium"
        android:textColor="@color/black87"
        android:textSize="@dimen/medium"
        android:gravity="center_vertical"
        tools:text="Text"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/quesSectionCollapseImg"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_margin="@dimen/card_padding"
        android:gravity="center_vertical"
        android:src="@drawable/ic_keyboard_arrow_down_black"
        android:layout_alignParentEnd="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        />
    <View
        android:id="@+id/quesSectionSeparatorView"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_margin="@dimen/card_padding"
        android:background="@color/separatorColor"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/quesSectionHeadingTV"/>

</androidx.constraintlayout.widget.ConstraintLayout>




