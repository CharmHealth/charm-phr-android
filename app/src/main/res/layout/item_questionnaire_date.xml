<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/card_margin_horizontal"
    android:layout_marginEnd="@dimen/card_margin_horizontal"
    android:layout_marginBottom="@dimen/card_padding"
    android:background="@drawable/item_questionnaire_bg"
    android:elevation="1dp">

    <TextView
        android:id="@+id/questionnaireDetailItemQuesAnsHint"
        style="@style/itemQuestionnaireHint"
        app:layout_constraintEnd_toStartOf="@id/questionnaireDetailItemDateImg"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="Question" />

    <TextView
        android:layout_width="0dp"
        android:layout_height="@dimen/questionnaire_detail_simple_ques_ans_value_height"
        android:layout_marginStart="@dimen/card_padding"
        android:layout_marginTop="@dimen/questionnaire_detail_ques_ans_value_margin_top"
        android:layout_marginEnd="@dimen/card_padding"
        android:layout_marginBottom="@dimen/card_padding"
        android:background="@android:color/transparent"
        android:ellipsize="end"
        android:fontFamily="@font/open_sans"
        android:gravity="start|center_vertical"
        android:maxLines="1"
        android:textColor="@color/edittext_txt_color"
        android:textSize="@dimen/xx_medium"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/questionnaireDetailItemDateImg"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/questionnaireDetailItemQuesAnsHint"
        tools:text="Answer" />

    <ImageView
        android:id="@+id/questionnaireDetailItemDateImg"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/card_padding"
        android:src="@drawable/ic_calander"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>