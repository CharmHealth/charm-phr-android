<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@android:color/transparent">

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dashboard_card_margin"
        android:layout_marginTop="@dimen/dashboard_health_vertical_margin"
        android:layout_marginEnd="@dimen/dashboard_card_margin"
        android:layout_marginBottom="@dimen/dashboard_health_vertical_margin"
        app:cardBackgroundColor="@android:color/white"
        app:cardCornerRadius="@dimen/common_card_radius"
        app:cardElevation="@dimen/common_card_elevation">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/wellnessModuleListConstraintLayout"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@drawable/item_ripple_white_bg">

            <ImageView
                android:id="@+id/wellnessModuleListIcon"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="8dp"
                android:visibility="gone"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:src="@drawable/ic_wellness" />

            <TextView
                android:id="@+id/wellnessModuleListDummyTV"
                style="@style/genderOtherTxtStyle"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="8dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"

                tools:text="A J" />


            <TextView
                android:id="@+id/wellnessModuleListName"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_marginStart="@dimen/dashboard_card_padding"
                android:layout_marginEnd="@dimen/dashboard_card_padding"
                android:fontFamily="@font/open_sans_medium"
                android:gravity="center_vertical"
                android:textColor="@color/black87"
                android:textSize="@dimen/medium"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@id/wellnessModuleListNxtBtn"
                app:layout_constraintStart_toEndOf="@id/wellnessModuleListIcon"
                app:layout_constraintTop_toTopOf="parent" />


            <ImageView
                android:id="@+id/wellnessModuleListNxtBtn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/dashboard_card_padding"
                android:src="@drawable/ic_hp_nav_next"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>
</FrameLayout>