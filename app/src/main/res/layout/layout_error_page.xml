<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/commonBgColor">

    <ImageView
        android:id="@+id/errorPageImg"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:scaleType="fitXY"
        android:src="@drawable/ic_something_went_wrong"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias=".3" />

    <TextView
        android:id="@+id/errorPageHeading"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="24dp"
        android:layout_marginEnd="20dp"
        android:fontFamily="@font/open_sans_medium"
        android:text="@string/error_page_msg1"
        android:textAlignment="center"
        android:textSize="@dimen/x_medium"
        android:textColor="@color/black87"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/errorPageImg" />

    <TextView
        android:id="@+id/errorPageTV"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="@dimen/common_card_item_margin_vertical"
        android:layout_marginEnd="20dp"
        android:fontFamily="@font/open_sans"
        android:textSize="@dimen/x_medium"
        android:text="@string/error_page_msg2"
        android:textAlignment="center"
        android:textColor="@color/black87"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/errorPageHeading" />

    <Button
        android:id="@+id/errorPageTryAgainBtn"
        style="@style/mdMiniButtonStyle"
        android:layout_width="wrap_content"
        android:layout_height="42dp"
        android:paddingEnd="48dp"
        android:paddingStart="48dp"
        android:layout_marginTop="28dp"
        android:text="@string/retry_str"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/errorPageTV" />


</androidx.constraintlayout.widget.ConstraintLayout>