<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/card_padding"
    android:layout_marginTop="@dimen/wellness_list_margin_vertical"
    android:layout_marginEnd="@dimen/card_padding"
    android:layout_marginBottom="@dimen/wellness_list_margin_vertical"
    android:background="@drawable/item_wellness_list_bg">

    <TextView
        android:id="@+id/wellnessListDateTV"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/edittext_padding"
        android:layout_marginTop="@dimen/card_padding_half"
        android:layout_marginEnd="@dimen/edittext_padding"
        android:fontFamily="@font/open_sans"
        android:textColor="@color/black87"
        android:textSize="@dimen/small"
        app:layout_constraintEnd_toStartOf="@id/wellnessListTimeTV"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="Jul 18, 2020" />

    <TextView
        android:id="@+id/wellnessListTimeTV"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/card_padding"
        android:layout_marginTop="@dimen/card_padding_half"
        android:layout_marginEnd="@dimen/edittext_padding"
        android:fontFamily="@font/open_sans"
        android:textColor="@color/black87"
        android:textSize="@dimen/tiny"
        app:layout_constraintBottom_toBottomOf="@id/wellnessListDateTV"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/wellnessListDateTV"
        tools:text="11:00 AM" />

    <TextView
        android:id="@+id/wellnessListValueTV"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/edittext_padding"
        android:layout_marginTop="@dimen/common_card_item_margin_vertical"
        android:layout_marginEnd="@dimen/edittext_padding"
        android:layout_marginBottom="@dimen/card_padding_half"
        android:fontFamily="@font/open_sans_medium"
        android:textColor="@android:color/black"
        android:textSize="@dimen/medium"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/wellnessListDateTV"
        tools:text="11/70 mmHg" />

</androidx.constraintlayout.widget.ConstraintLayout>