<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/card_margin_horizontal"
    android:layout_marginEnd="@dimen/card_margin_horizontal"
    android:layout_marginBottom="@dimen/questionnaire_card_margin_vertical"
    android:layout_marginTop="@dimen/questionnaire_card_margin_vertical"
    android:background="@drawable/item_questionnaire_permission_bg">

    <ImageView
        android:id="@+id/questionnairePermissionImg"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginStart="12dp"
        android:src="@drawable/ic_warning"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/questionnairePermissionTV"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/questionnaire_permission_margin_vertical"
        android:fontFamily="@font/open_sans_medium"
        android:textColor="@color/questionnairePermissionTxtColor"
        android:textSize="@dimen/medium"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/questionnairePermissionImg"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="Your personal data (PHI) will not be shared or used for research without your consent" />
</androidx.constraintlayout.widget.ConstraintLayout>