<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@android:color/white"
    android:orientation="vertical">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="0dp"

        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/book_appointment_slot_date_picker_horizontal_margin"

        android:layout_marginEnd="@dimen/book_appointment_slot_heading_button_horizontal_margin"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/calendarRightScrollBtn"
        app:layout_constraintStart_toEndOf="@+id/calendarLeftScrollBtn"
        app:layout_constraintTop_toTopOf="parent">

        <RelativeLayout
            android:id="@+id/monthAndYearContainerLayout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:orientation="horizontal"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <include
                layout="@layout/text_view_month_and_year"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="invisible" />
            <!--inorder maintain view height-->

        </RelativeLayout>

        <com.charm.phr.mphr.ui.components.HorizontalCalendar.CalendarRecyclerView
            android:id="@+id/calendarViewComponent"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/monthAndYearContainerLayout"
            tools:listitem="@layout/item_horizontal_calendar" />

        <View
            android:layout_width="@dimen/calendarScrollGradientViewWidth"
            android:layout_height="0dp"
            android:layout_marginTop="30dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

        </View>

        <View
            android:layout_width="@dimen/calendarScrollGradientViewWidth"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent">

        </View>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <ImageView
        android:id="@+id/calendarLeftScrollBtn"
        android:layout_width="@dimen/calendarScrollArrowBtnWidth"
        android:layout_height="@dimen/calendarScrollArrowBtnHeight"
        android:layout_marginStart="10dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:src="@drawable/ic_arrow_back_white"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.72" />

    <ImageView
        android:id="@+id/calendarRightScrollBtn"
        android:layout_width="@dimen/calendarScrollArrowBtnWidth"
        android:layout_height="@dimen/calendarScrollArrowBtnHeight"
        android:layout_marginEnd="10dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:src="@drawable/ic_arrow_back_white"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.72" />


</androidx.constraintlayout.widget.ConstraintLayout>