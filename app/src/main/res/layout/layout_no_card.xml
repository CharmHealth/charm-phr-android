<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/commonBgColor">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias=".4">

        <ImageView
            android:id="@+id/nocardImageView"
            android:layout_width="200dp"
            android:layout_height="200dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_no_card" />
        <!--            app:forceClip="true"-->
        <!--            app:isTranslucent="true"-->


        <TextView
            android:id="@+id/nocardTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/open_sans_medium"
            android:gravity="center_horizontal"
            android:text="@string/no_card_available"
            android:textColor="@color/black87"
            android:textSize="@dimen/medium" />

        <TextView
            android:id="@+id/nocardTextViewHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/common_card_item_margin_vertical"
            android:layout_marginBottom="@dimen/card_padding"
            android:fontFamily="@font/open_sans"
            android:gravity="center"
            android:text="@string/card_add_hint"
            android:textColor="@color/black87"
            android:textSize="@dimen/small" />
    </LinearLayout>


</androidx.constraintlayout.widget.ConstraintLayout>

