<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/billingDetailRootLayout"
    android:background="@color/commonBgColor"
    tools:context=".ui.billing.billingDetail.BillingDetailActivity">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/billingDetailToolbar"
        android:layout_width="match_parent"
        android:layout_height="?actionBarSize"
        android:background="@color/toolbarBg"
        android:clickable="true"
        android:focusable="true"
        android:focusableInTouchMode="true"
        app:contentInsetStart="0dp"
        app:contentInsetStartWithNavigation="0dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <requestFocus />

        <ImageButton
            android:id="@+id/billingDetailBackBtn"
            android:layout_width="@dimen/toolBarBtnWd"
            android:layout_height="match_parent"
            android:layout_gravity="start"
            android:background="?selectableItemBackgroundBorderless"
            android:src="@drawable/ic_arrow_back_white" />

        <TextView
            android:id="@+id/billingDetailToolbarText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/toolbar_text_left_margin"
            android:text="@string/billing_detail_toolbar_txt"
            android:textAppearance="@style/toolbarText" />

        <ImageButton
            android:id="@+id/billingDetailPDFShareBtn"
            android:layout_width="@dimen/toolBarBtnWd"
            android:layout_height="match_parent"
            android:layout_gravity="end"
            android:background="?selectableItemBackgroundBorderless"
            android:src="@drawable/ic_share"
            android:visibility="visible" />

    </androidx.appcompat.widget.Toolbar>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/billingDetailMainLayout"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/billingDetailToolbar">

        <androidx.cardview.widget.CardView
            android:id="@+id/billingDetailPaymentDetailCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/card_margin_horizontal"
            android:layout_marginTop="@dimen/billing_detail_item_margin_top"
            android:layout_marginEnd="@dimen/card_margin_horizontal"
            android:layout_marginBottom="@dimen/card_margin_vertical"
            app:cardBackgroundColor="@android:color/white"
            app:cardCornerRadius="@dimen/common_card_radius"
            app:cardElevation="@dimen/common_card_elevation"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/item_ripple_white_bg">

                <TextView
                    android:id="@+id/billingDetailInvoiceDateTV"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="@dimen/card_padding"
                    android:paddingTop="@dimen/card_padding"
                    android:paddingEnd="@dimen/card_padding"
                    android:textAppearance="@style/dateDisplayTxtAppearance"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHorizontal_bias="0"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    tools:text="Jun 10, 2000 " />

                <TextView
                    android:id="@+id/billingDetailInvoiceFacilityNameTV"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="@font/open_sans_medium"
                    android:paddingStart="@dimen/card_padding"
                    android:paddingEnd="@dimen/card_padding"
                    android:textColor="@color/black87"
                    android:textSize="@dimen/x_medium"
                    app:layout_constraintEnd_toStartOf="@id/billingDetailInvoiceBillNumTV"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/billingDetailInvoiceDateTV"
                    tools:text="Charm Multispeciality" />

                <TextView
                    android:id="@+id/billingDetailInvoiceBillNumTV"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/open_sans"
                    android:paddingStart="0dp"
                    android:paddingEnd="@dimen/card_padding"
                    android:textColor="@color/black70"
                    android:textSize="@dimen/x_medium"
                    app:layout_constraintBottom_toBottomOf="@id/billingDetailInvoiceFacilityNameTV"
                    app:layout_constraintEnd_toEndOf="parent"
                    tools:text="INV3000" />


                <TextView
                    android:id="@+id/billingDetailPaymentReqTV"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/common_card_item_margin_vertical"
                    android:layout_marginBottom="@dimen/card_padding"
                    android:paddingStart="0dp"
                    android:paddingEnd="@dimen/card_padding"
                    android:textAppearance="@style/invoiceDueAmtTxtAppearance"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/billingDetailInvoiceFacilityNameTV"
                    tools:text="$ 200.00" />

                <TextView
                    android:id="@+id/billingDetailPaymentReqLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/open_sans"
                    android:paddingStart="@dimen/card_padding"
                    android:paddingEnd="@dimen/card_padding"
                    android:text="@string/payment_requested"
                    android:textColor="@color/black70"
                    android:textSize="@dimen/xx_small"
                    app:layout_constraintBottom_toBottomOf="@id/billingDetailPaymentReqTV"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="@id/billingDetailPaymentReqTV" />


            </androidx.constraintlayout.widget.ConstraintLayout>


        </androidx.cardview.widget.CardView>


        <androidx.cardview.widget.CardView
            android:id="@+id/billingDetailMainPDF"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginStart="@dimen/card_margin_horizontal"
            android:layout_marginTop="@dimen/billing_detail_item_margin_top"
            android:layout_marginEnd="@dimen/card_margin_horizontal"
            android:layout_marginBottom="@dimen/card_margin_horizontal"
            app:cardBackgroundColor="@android:color/white"
            app:cardCornerRadius="@dimen/common_card_radius"
            app:cardElevation="@dimen/common_card_elevation"
            app:layout_constraintBottom_toTopOf="@id/billingDetailPayBtn"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/billingDetailPaymentDetailCard">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/item_ripple_white_bg">


                <com.rajat.pdfviewer.PdfRendererView
                    android:id="@+id/billingDetailPDFViewer"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:pdfView_showDivider="false" />

                <include
                    android:id="@+id/billingDetailPDFErrorPage"
                    layout="@layout/layout_error_page" />
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.cardview.widget.CardView>

        <Button
            style="@style/mdButtonStyle"
            android:id="@+id/billingDetailPayBtn"
            android:layout_width="match_parent"
            android:layout_height="@dimen/add_button_height"
            android:layout_marginStart="@dimen/button_margin"
            android:layout_marginEnd="@dimen/button_margin"
            android:layout_marginBottom="@dimen/button_margin"
            android:background="@drawable/item_button_bg"
            android:fontFamily="@font/open_sans_medium"
            android:text="@string/billing_detail_pay_str"
            android:textColor="@android:color/white"
            android:textSize="@dimen/large"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/billingDetailMainPDF" />

    </androidx.constraintlayout.widget.ConstraintLayout>


    <include
        android:id="@+id/billingDetailProgress"
        layout="@layout/layout_progress_bar"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/billingDetailToolbar"
        tools:visibility="gone" />


</androidx.constraintlayout.widget.ConstraintLayout>