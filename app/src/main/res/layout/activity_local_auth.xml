<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/authMainLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/commonBgColor">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/authToolbar"
        android:layout_width="match_parent"
        android:layout_height="?actionBarSize"
        android:background="@color/toolbarBg"
        app:contentInsetStart="0dp"
        app:contentInsetStartWithNavigation="0dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/authBackBtn"
            android:layout_width="@dimen/toolBarBtnWd"
            android:layout_height="match_parent"
            android:layout_gravity="start"
            android:background="?selectableItemBackgroundBorderless"
            android:src="@drawable/ic_arrow_back_white"
            android:visibility="gone" />

        <TextView
            android:id="@+id/authToolbarText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dashboard_card_margin"
            android:text="@string/app_lock"
            android:textAppearance="@style/toolbarText" />

    </androidx.appcompat.widget.Toolbar>

    <androidx.cardview.widget.CardView
        android:id="@+id/sysLockCV"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dashboard_card_margin"
        android:layout_marginTop="@dimen/common_margin_vertical"
        android:layout_marginEnd="@dimen/dashboard_card_margin"
        android:layout_marginBottom="@dimen/common_margin_vertical_half"
        app:cardBackgroundColor="@android:color/white"
        app:cardCornerRadius="@dimen/common_card_radius"
        app:cardElevation="@dimen/common_card_elevation"
        app:layout_constraintBottom_toTopOf="@+id/charmLockCV"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/authToolbar">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <TextView
                android:id="@+id/sysLockTV"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/card_padding"
                android:layout_marginTop="@dimen/card_padding"
                android:layout_marginEnd="@dimen/card_padding"
                android:fontFamily="@font/open_sans_medium"
                android:text="@string/system_lock"
                android:textColor="@color/allergyListNameAndTypeTxtColor"
                android:textSize="@dimen/x_medium"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <ImageView
                android:id="@+id/sysLockIB"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="?selectableItemBackgroundBorderless"
                android:paddingStart="@dimen/card_padding"
                android:paddingTop="@dimen/card_padding"
                android:paddingEnd="@dimen/card_padding"
                android:src="@drawable/ic_unchecked"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent">

            </ImageView>

            <TextView
                android:id="@+id/sysLockMsgTV"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/card_padding"
                android:layout_marginTop="@dimen/hp_url_bg_top_margin"
                android:layout_marginEnd="@dimen/card_padding"
                android:layout_marginBottom="@dimen/card_padding"
                android:textAppearance="@style/cardDescriptionText"
                android:text="@string/unlock_charm_mPHR_using_sys_lock"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/sysLockIB"
                app:layout_constraintHorizontal_bias="0.0"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/sysLockTV"
                app:layout_constraintVertical_bias="0.0" />
        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.cardview.widget.CardView>

    <androidx.cardview.widget.CardView
        android:id="@+id/charmLockCV"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dashboard_card_margin"
        android:layout_marginTop="@dimen/common_margin_vertical"
        android:layout_marginEnd="@dimen/dashboard_card_margin"
        android:layout_marginBottom="@dimen/common_margin_vertical"
        app:cardBackgroundColor="@android:color/white"
        app:cardCornerRadius="@dimen/common_card_radius"
        app:cardElevation="@dimen/common_card_elevation"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/sysLockCV">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <TextView
                android:id="@+id/charmLockTV"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/card_padding"
                android:layout_marginTop="@dimen/card_padding"
                android:layout_marginEnd="@dimen/card_padding"
                android:fontFamily="@font/open_sans_medium"
                android:text="@string/app_specific_lock"
                android:textColor="@color/allergyListNameAndTypeTxtColor"
                android:textSize="@dimen/x_medium"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <ImageView
                android:id="@+id/charmLockIB"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="?selectableItemBackgroundBorderless"
                android:clickable="false"
                android:paddingStart="@dimen/card_padding"
                android:paddingTop="@dimen/card_padding"
                android:paddingEnd="@dimen/card_padding"
                android:src="@drawable/ic_unchecked"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent">

            </ImageView>

            <TextView
                android:id="@+id/charmlockMsgTV"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/card_padding"
                android:layout_marginTop="@dimen/hp_url_bg_top_margin"
                android:layout_marginEnd="@dimen/card_padding"
                android:layout_marginBottom="@dimen/card_padding"
                android:textAppearance="@style/cardDescriptionText"
                android:text="@string/app_specific_lock_msg"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/charmLockIB"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/charmLockTV" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.cardview.widget.CardView>

    <ImageButton
        android:id="@+id/infoIV"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="start"
        android:layout_marginStart="@dimen/card_padding"
        android:background="?selectableItemBackgroundBorderless"
        android:src="@drawable/ic_info"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/configEditMsg"
        app:layout_constraintBottom_toBottomOf="@+id/configEditMsg"/>

    <TextView
        android:id="@+id/configEditMsg"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/card_padding"
        android:layout_marginEnd="20dp"
        android:layout_marginStart="20dp"
        android:visibility="gone"
        android:textAppearance="@style/cardDescriptionText"
        android:textSize="@dimen/xx_small"
        android:text="@string/config_edit_info"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/infoIV"
        app:layout_constraintTop_toBottomOf="@+id/charmLockCV"
        />


</androidx.constraintlayout.widget.ConstraintLayout>