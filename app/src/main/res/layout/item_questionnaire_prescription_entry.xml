<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/card_margin_horizontal"
    android:layout_marginTop="@dimen/questionnaire_card_margin_vertical"
    android:layout_marginEnd="@dimen/card_margin_horizontal"
    android:layout_marginBottom="@dimen/questionnaire_card_margin_vertical"
    android:animateLayoutChanges="true"
    android:background="@drawable/item_questionnaire_bg"
    android:elevation="1dp"
    android:orientation="vertical">

    <TextView
        android:id="@+id/questionnaireDetailItemPescriptionHintTV"
        style="@style/itemQuestionnaireWidgetNotes"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="Medication"

        />

    <TextView
        android:id="@+id/questionnaireDetailItemPrescriptionDeleteTV"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:background="@android:color/transparent"
        android:fontFamily="@font/open_sans_medium"
        android:paddingStart="@dimen/card_padding"
        android:paddingEnd="@dimen/card_padding"
        android:paddingBottom="@dimen/card_padding"
        android:text="@string/delete_str"
        android:textAllCaps="true"
        android:textColor="@color/colorAccent"
        android:textSize="@dimen/medium"
        app:layout_constraintBottom_toBottomOf="@id/questionnaireDetailItemPescriptionHintTV"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/questionnaireDetailItemPescriptionHintTV" />

    <LinearLayout
        android:id="@+id/questionnaireDetailItemPrescriptionMainLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/questionnaireDetailItemPescriptionHintTV">

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/questionnaireDetailItemPrescriptionNameLayout"
            style="@style/itemQuestionnaireAllergyTextInputLayoutTheme"
            android:layout_height="56dp"
            android:layout_marginTop="@dimen/card_padding_half"
            android:layout_marginBottom="0dp"
            app:hintTextAppearance="@style/itemEdittextHintTxtAppearance"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <com.charm.phr.mphr.ui.components.MDTextInputEdittext

                android:id="@+id/questionnaireDetailItemPrescriptionNameET"
                style="@style/itemTextInputEdittextTheme"
                android:dropDownAnchor="@id/addMedicationNameLayout"
                android:hint="@string/medication_drug_name_str"
                android:maxLength="@integer/addMedicationDrugNameMaxLength"

                />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/questionnaireDetailItemPrescriptionIntakeDetailsLayout"
            style="@style/itemQuestionnaireAllergyTextInputLayoutTheme"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/card_padding_half"
            android:layout_marginBottom="@dimen/card_padding"
            android:minHeight="@dimen/textinput_edittext_height"
            app:helperTextTextAppearance="@style/itemEdittextHelperTxtAppearance"
            app:hintTextAppearance="@style/itemEdittextHintTxtAppearance"

            >

            <com.charm.phr.mphr.ui.components.MDTextInputEdittext
                android:id="@+id/questionnaireDetailItemPrescriptionIntakeDetailsET"
                style="@style/itemTextInputEdittextMultiLineTheme"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/medication_intake_details_str"
                android:maxLength="@integer/addAllergyReactionsMaxLength" />
        </com.google.android.material.textfield.TextInputLayout>


    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>