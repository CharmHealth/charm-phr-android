<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/dashboardNavigationSide1ItemTheme"
    android:layout_width="match_parent"
    android:layout_height="73dp"
    android:orientation="vertical">

    <de.hdodenhof.circleimageview.CircleImageView
        android:id="@+id/dashboardNavigationPatListPatientImg"
        android:layout_width="@dimen/dashboard_navigation_patient_list_img_size"
        android:layout_height="@dimen/dashboard_navigation_patient_list_img_size"
        android:layout_marginStart="@dimen/dashboard_navigation_side1_item_icon_margin_horizontal"
        android:src="@drawable/ic_patient_male_dummy"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/dashboardNavigationPatListPatientDummyPicTV"
        style="@style/genderOtherTxtStyle"
        android:layout_width="@dimen/dashboard_navigation_patient_list_img_size"
        android:layout_height="@dimen/dashboard_navigation_patient_list_img_size"
        android:layout_marginStart="@dimen/dashboard_navigation_side1_item_icon_margin_horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/dashboardNavigationPatListGuideline"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintGuide_percent=".5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/dashboardNavigationPatListPatientName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dashboard_navigation_side1_item_icon_margin_horizontal"
        android:layout_marginEnd="@dimen/card_margin_horizontal"
        android:fontFamily="@font/open_sans_medium"
        android:gravity="start"
        android:textColor="@color/black87"
        android:textSize="@dimen/xx_small"
        app:layout_constraintBottom_toTopOf="@id/dashboardNavigationPatListGuideline"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/dashboardNavigationPatListPatientImg"
        tools:text="Adam Colon" />

    <TextView
        android:id="@+id/dashboardNavigationPatListDetailTV"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dashboard_navigation_side1_item_icon_margin_horizontal"
        android:layout_marginTop="@dimen/common_card_item_margin_vertical"
        android:layout_marginEnd="@dimen/card_margin_horizontal"
        android:fontFamily="@font/open_sans"
        android:gravity="start"
        android:textColor="@color/dashboardNavigationPatListDetailTxtColor"
        android:textSize="@dimen/small"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/dashboardNavigationPatListPatientImg"
        app:layout_constraintTop_toBottomOf="@id/dashboardNavigationPatListGuideline"
        tools:text="Male , 30" />
</androidx.constraintlayout.widget.ConstraintLayout>