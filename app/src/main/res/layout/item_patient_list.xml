<?xml version="1.0" encoding="utf-8"?>

<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/card_margin_patient_list_horizontal"
        android:layout_marginTop="@dimen/card_margin_patient_list_vertical"
        android:layout_marginEnd="@dimen/card_margin_patient_list_horizontal"
        android:layout_marginBottom="@dimen/card_margin_patient_list_vertical"
        app:cardBackgroundColor="@android:color/white"
        app:cardCornerRadius="@dimen/common_card_radius"
        app:cardElevation="@dimen/common_card_elevation">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/patient_list_card_height"
            android:background="@drawable/item_ripple_white_bg"
            android:padding="@dimen/card_padding">

            <de.hdodenhof.circleimageview.CircleImageView
                android:id="@+id/patientListImg"
                android:layout_width="@dimen/patient_list_img_size"
                android:layout_height="@dimen/patient_list_img_size"
                android:layout_gravity="center_vertical"
                android:background="@android:color/transparent"
                android:cropToPadding="true"
                android:src="@drawable/ic_patient_female_dummy"
                app:civ_circle_background_color="@android:color/white"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/patientListDummyTV"
                style="@style/genderOtherTxtStyle"
                android:layout_width="@dimen/patient_list_img_size"
                android:layout_height="@dimen/patient_list_img_size"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="15dp"
                android:orientation="vertical"
                android:weightSum="2"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/patientListImg"
                app:layout_constraintTop_toTopOf="parent">

                <TextView
                    android:id="@+id/patientListName"
                    android:layout_width="wrap_content"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:ellipsize="middle"
                    android:fontFamily="@font/open_sans_medium"
                    android:gravity="center_vertical"
                    android:singleLine="true"
                    android:textColor="@color/black87"
                    android:textSize="@dimen/x_medium"
                    tools:text="Harry potter" />

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1">

                    <TextView
                        android:id="@+id/patientListDetail"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:layout_alignParentStart="true"
                        android:layout_marginTop="@dimen/common_card_item_margin_vertical"
                        android:fontFamily="@font/open_sans"
                        android:gravity="top"
                        android:textColor="@color/patientListDetailTxtColor"
                        android:textSize="@dimen/x_small"
                        tools:text="May 31, 1998" />

