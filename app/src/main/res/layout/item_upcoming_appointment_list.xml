<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/itemUpcomingAppointmentLisMainLayout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/dashboard_upcoming_appointment_item_vertical_margin"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical"
    android:paddingStart="@dimen/dashboard_card_padding"
    android:paddingEnd="@dimen/dashboard_card_padding">

    <com.charm.phr.mphr.ui.components.MDmPHRConstraintLayout
        android:id="@+id/upcomingAppointmentDateAndDayLayout"
        android:layout_width="44dp"
        android:layout_height="62dp"
        android:layout_marginTop="2.5dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:mdBackgroundColor="@color/upcomingAppointmentDateAndDayLayoutBg"
        app:mdCornerRadius="6dp">

        <TextView
            android:id="@+id/upcomingAppointmentDateTV"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/open_sans_bold"
            android:textColor="@android:color/white"
            android:textSize="@dimen/xx_large"
            app:layout_constraintBottom_toTopOf="@id/upcomingAppointmentDayTV"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="26" />

        <TextView
            android:id="@+id/upcomingAppointmentDayTV"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:fontFamily="@font/open_sans_medium"
            android:textColor="@android:color/white"
            android:textSize="@dimen/small"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/upcomingAppointmentDateTV"

            tools:text="Fri" />


    </com.charm.phr.mphr.ui.components.MDmPHRConstraintLayout>


    <TextView
        android:id="@+id/upcomingAppointmentProviderNameTV"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dashboard_card_padding"
        android:layout_marginEnd="@dimen/dashboard_card_padding"
        android:layout_weight="1"
        android:ellipsize="middle"
        android:fontFamily="@font/open_sans_medium"
        android:singleLine="true"
        android:textColor="@color/black87"
        android:textSize="@dimen/xx_medium"
        app:layout_constraintBottom_toTopOf="@id/upcomingAppointmentFacilityNameTV"
        app:layout_constraintEnd_toStartOf="@id/upcomingAppointmentStartTimeTV"
        app:layout_constraintStart_toEndOf="@id/upcomingAppointmentDateAndDayLayout"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="Dr . William Abertnet" />

    <TextView
        android:id="@+id/upcomingAppointmentFacilityNameTV"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dashboard_card_padding"
        android:layout_marginTop="@dimen/common_card_item_margin_vertical"
        android:layout_marginEnd="@dimen/dashboard_card_padding"
        android:layout_marginBottom="6dp"
        android:ellipsize="end"
        android:fontFamily="@font/open_sans"
        android:gravity="top"
        android:maxLines="2"
        android:textColor="@color/upcomingAppointmentFacilityNameTxtColor"
        android:textSize="@dimen/x_small"
        app:layout_constraintEnd_toStartOf="@id/upcomingAppointmentQuestionnaireLayout"
        app:layout_constraintStart_toEndOf="@id/upcomingAppointmentDateAndDayLayout"
        app:layout_constraintTop_toBottomOf="@id/upcomingAppointmentProviderNameTV"
        tools:text="Charm Health Clinic"

        />

    <TextView
        android:id="@+id/upcomingAppointmentTimezoneTV"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dashboard_card_padding"
        android:layout_marginTop="@dimen/common_card_item_margin_vertical"
        android:layout_marginEnd="@dimen/dashboard_card_padding"
        android:layout_marginBottom="6dp"
        android:fontFamily="@font/open_sans"
        android:gravity="top"
        android:textColor="@color/upcomingAppointmentFacilityNameTxtColor"
        android:textSize="@dimen/x_small"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/upcomingAppointmentQuestionnaireLayout"
        app:layout_constraintStart_toEndOf="@id/upcomingAppointmentDateAndDayLayout"
        app:layout_constraintTop_toBottomOf="@id/upcomingAppointmentFacilityNameTV"
        tools:text="Charm Health Clinic"

        />

    <TextView
        android:id="@+id/upcomingAppointmentStartTimeTV"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/open_sans_medium"
        android:textColor="@color/black87"
        android:textSize="@dimen/medium"
        app:layout_constraintBottom_toBottomOf="@id/upcomingAppointmentProviderNameTV"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/upcomingAppointmentProviderNameTV"
        tools:text="10 : 00 AM" />

    <com.charm.phr.mphr.ui.components.MDmPHRConstraintLayout
        android:id="@+id/upcomingAppointmentQuestionnaireLayout"
        android:layout_width="wrap_content"
        android:layout_height="28dp"
        android:layout_margin="@dimen/card_padding_half"
        android:layout_marginStart="@dimen/card_padding"
        android:paddingStart="@dimen/card_padding"
        android:paddingTop="2dp"
        android:paddingEnd="@dimen/card_padding"
        android:paddingBottom="2dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/upcomingAppointmentTimezoneTV"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/upcomingAppointmentFacilityNameTV"

        app:layout_constraintVertical_bias="1"
        app:mdBackgroundColor="@color/colorPrimary"
        app:mdCornerRadius="5dp"
        tools:visibility="visible">

        <TextView
            android:id="@+id/upcomingAppointmentQuestionnaireTV"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginStart="4dp"
            android:fontFamily="@font/open_sans_medium"
            android:gravity="center_vertical"
            android:text="@string/fill_questionnaire_txt"
            android:textAllCaps="true"
            android:textColor="@color/textColorForColorPrimaryBg"
            android:textSize="@dimen/small"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/todayAppointmentVideoCamImg"
            app:layout_constraintTop_toTopOf="parent" />
    </com.charm.phr.mphr.ui.components.MDmPHRConstraintLayout>


</androidx.constraintlayout.widget.ConstraintLayout>
