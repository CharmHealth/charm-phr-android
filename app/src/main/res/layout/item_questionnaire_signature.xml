<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/questionnaire_card_margin_vertical">

    <TextView
        android:id="@+id/questionnaireDetailItemSignatureHint"
        style="@style/itemQuestionnaireHint"
        android:layout_marginStart="@dimen/card_margin_horizontal"
        android:maxLines="2"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="Question" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/questionnaireDetailItemSignatureLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/card_margin_horizontal"
        android:layout_marginTop="@dimen/card_padding"
        android:layout_marginEnd="@dimen/card_margin_horizontal"
        android:layout_marginBottom="@dimen/questionnaire_card_margin_vertical"
        android:background="@drawable/item_questionnaire_bg"
        android:elevation="1dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/questionnaireDetailItemSignatureHint">

        <com.github.gcacace.signaturepad.views.SignaturePad
            android:id="@+id/questionnaireDetailItemSignaturePad"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:penColor="@android:color/black" />

        <TextView
            android:id="@+id/questionnaireDetailItemSignatureSaveBtn"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:fontFamily="@font/open_sans_medium"
            android:paddingStart="@dimen/book_appointment_et_end_padding"
            android:paddingTop="@dimen/common_edit_btn_top_padding"
            android:paddingEnd="@dimen/book_appointment_et_end_padding"
            android:visibility="gone"
            android:background="@drawable/item_ripple_buttons"
            android:paddingBottom="@dimen/book_appointment_et_end_padding"
            android:text="@string/resignature_str"
            android:textColor="@color/colorPrimary"
            android:textSize="@dimen/medium"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>


        <TextView
            android:id="@+id/questionnaireDetailItemSignatureInfo"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:clickable="true"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:fontFamily="@font/open_sans"
            android:gravity="center"
            android:text="@string/click_and_drag_to_sign_the_questionnaire"
            android:textColor="@color/black56"
            android:textSize="@dimen/xx_medium"
            app:layout_constraintBottom_toBottomOf="@id/questionnaireDetailItemSignaturePad"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/questionnaireDetailItemSignaturePad"
            />


    </androidx.constraintlayout.widget.ConstraintLayout>


</androidx.constraintlayout.widget.ConstraintLayout>