<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/allergyMainLayout"
    android:background="@color/commonBgColor"
    tools:context=".ui.allergy.AllergyActivity">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/allergyToolbar"
        android:layout_width="match_parent"
        android:layout_height="?actionBarSize"
        android:background="@color/toolbarBg"
        android:elevation="@dimen/tab_elevation"
        app:contentInsetStart="0dp"
        app:contentInsetStartWithNavigation="0dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <ImageButton
                android:id="@+id/allergyBackBtn"
                android:layout_width="@dimen/toolBarBtnWd"
                android:layout_height="match_parent"
                android:layout_gravity="start"
                android:background="?selectableItemBackgroundBorderless"
                android:src="@drawable/ic_arrow_back_white"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/allergyToolbarText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/toolbar_text_left_margin"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:text="@string/allergy_str"
                android:textAppearance="@style/toolbarText"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@id/allergyDeleteBtn"
                app:layout_constraintStart_toEndOf="@id/allergyBackBtn"
                app:layout_constraintTop_toTopOf="parent" />

            <ImageButton
                android:id="@+id/allergyDeleteBtn"
                android:layout_width="@dimen/toolBarBtnWd"
                android:layout_height="match_parent"
                android:layout_gravity="end"
                android:background="?selectableItemBackgroundBorderless"
                android:src="@drawable/ic_delete_white"
                android:visibility="gone"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@id/allergyFilterBtn"
                app:layout_constraintTop_toTopOf="parent" />

            <ImageButton
                android:id="@+id/allergyFilterBtn"
                android:layout_width="@dimen/toolBarBtnWd"
                android:layout_height="match_parent"
                android:layout_gravity="end"
                android:background="?selectableItemBackgroundBorderless"
                android:src="@drawable/ic_filter_white"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <View
                android:id="@+id/allergyFilterBtnAnchor"
                android:layout_width="1dp"
                android:layout_height="1dp"
                app:layout_constraintEnd_toStartOf="@id/allergyFilterBtn"
                app:layout_constraintTop_toTopOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.appcompat.widget.Toolbar>

