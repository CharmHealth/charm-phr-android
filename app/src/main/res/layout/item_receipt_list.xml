<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@android:color/transparent">

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/card_margin_horizontal"
        android:layout_marginTop="@dimen/card_margin_vertical"
        android:layout_marginEnd="@dimen/card_margin_horizontal"
        android:layout_marginBottom="@dimen/card_margin_vertical"
        app:cardBackgroundColor="@android:color/white"
        app:cardCornerRadius="@dimen/common_card_radius"
        app:cardElevation="@dimen/common_card_elevation">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/item_ripple_white_bg">

            <TextView
                android:id="@+id/receiptDateTV"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="@dimen/card_padding"
                android:paddingTop="@dimen/card_padding"
                android:paddingEnd="@dimen/card_padding"
                android:textAppearance="@style/dateDisplayTxtAppearance"
               app:layout_constraintEnd_toStartOf="@+id/receiptAddedFromLayout"
                app:layout_constraintHorizontal_bias="0"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:text="Jun 10, 2000 " />

            <com.charm.phr.mphr.ui.components.MDmPHRConstraintLayout
                android:id="@+id/receiptAddedFromLayout"
                android:layout_width="wrap_content"
                android:layout_height="0dp"
                android:visibility="gone"
                android:layout_marginTop="@dimen/card_padding"
                android:layout_marginEnd="@dimen/card_padding"
                app:layout_constraintHorizontal_bias="0"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:mdBackgroundColor="@color/scaleViewIndicatorColor"
                app:mdCornerRadius="3dp">

                <TextView
                    android:id="@+id/receiptAddedFromTV"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:fontFamily="@font/open_sans_medium"
                    android:gravity="center_vertical"
                    android:paddingStart="5dp"
                    android:paddingEnd="5dp"
                    android:textColor="@color/colorPrimary"
                    android:textSize="@dimen/small"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    tools:text="@string/allergy_severity_mild_str" />
            </com.charm.phr.mphr.ui.components.MDmPHRConstraintLayout>

            <TextView
                android:id="@+id/receiptFacilityNameTV"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="@font/open_sans_medium"
                android:paddingStart="@dimen/card_padding"
                android:paddingEnd="@dimen/card_padding"
                android:textColor="@color/black87"
                android:textSize="@dimen/x_medium"
                app:layout_constraintEnd_toStartOf="@id/receiptBillNumTV"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/receiptDateTV"
                tools:text="Charm Multispeciality" />

            <TextView
                android:id="@+id/receiptBillNumTV"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/open_sans"
                android:paddingStart="0dp"
                android:paddingEnd="@dimen/card_padding"
                android:textColor="@color/black70"
                android:textSize="@dimen/x_medium"
                app:layout_constraintBottom_toBottomOf="@id/receiptFacilityNameTV"
                app:layout_constraintEnd_toEndOf="parent"
                tools:text="INV3000" />

            <TextView
                android:id="@+id/receiptAmtValueTV"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/common_card_item_margin_vertical"
                android:layout_marginBottom="@dimen/card_padding"
                android:fontFamily="@font/open_sans_medium"
                android:paddingStart="0dp"
                android:paddingEnd="@dimen/card_padding"
                android:textColor="@color/receiptAmtPaidTxtColor"
                android:textSize="@dimen/xx_medium"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/receiptBillNumTV"
                tools:text="$ 2000.00" />

            <TextView
                android:id="@+id/receiptAmtPaidTV"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/open_sans_medium"
                android:paddingStart="@dimen/card_padding"
                android:paddingEnd="@dimen/card_padding"
                android:text="@string/receipt_amount_paid_str"
                android:textColor="@color/black70"
                android:textSize="@dimen/xx_small"
                app:layout_constraintBottom_toBottomOf="@id/receiptAmtValueTV"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@id/receiptAmtValueTV" />


        </androidx.constraintlayout.widget.ConstraintLayout>


    </androidx.cardview.widget.CardView>

</FrameLayout>