<?xml version="1.0" encoding="utf-8"?>
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/currentReminderListSwipeRefreshLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.reminder.CurrentReminderFragment">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <include
            android:id="@+id/reminderCurrentListNoDataTV"
            layout="@layout/layout_no_data"
            android:visibility="gone" />

        <TextView
            android:id="@+id/currentReminderCount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/card_margin_horizontal"
            android:layout_marginEnd="@dimen/card_margin_horizontal"
            android:fontFamily="@font/open_sans_medium"
            android:paddingTop="@dimen/common_margin_vertical"
            android:paddingBottom="@dimen/common_margin_vertical_half"
            android:textColor="@color/black87"
            android:textSize="@dimen/xx_small"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="3 Reminders" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/currentReminderListRV"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginBottom="@dimen/card_recycler_view_padding_vertical"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/currentReminderCount" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>