<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@android:color/transparent"
    tools:background="@color/black87">

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/card_margin_horizontal"
        android:layout_marginTop="@dimen/card_margin_vertical"
        android:layout_marginEnd="@dimen/card_margin_horizontal"
        android:layout_marginBottom="@dimen/card_margin_vertical"
        app:cardBackgroundColor="@android:color/white"
        app:cardCornerRadius="@dimen/common_card_radius"
        app:cardElevation="@dimen/common_card_elevation">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/item_ripple_white_bg"
            android:paddingBottom="@dimen/card_padding">

            <TextView
                android:id="@+id/labOrderDateTV"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="@dimen/card_padding"
                android:paddingTop="@dimen/card_padding"
                android:paddingEnd="@dimen/card_padding"
                android:textAppearance="@style/dateDisplayTxtAppearance"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:text="Jun 10, 2000" />

            <TextView
                android:id="@+id/labOrderLabPDFNameTV"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/common_card_item_margin_vertical"
                android:ellipsize="end"
                android:fontFamily="@font/open_sans_medium"
                android:maxLines="1"
                android:paddingStart="@dimen/card_padding"
                android:paddingEnd="@dimen/card_padding"
                android:textColor="@color/black87"
                android:textSize="@dimen/x_medium"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/labOrderDateTV"
                tools:text="Quest Diagnostics" />

            <TextView
                android:id="@+id/labOrderSharedByTV"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/common_card_item_margin_vertical"
                android:fontFamily="@font/open_sans"
                android:paddingStart="@dimen/card_padding"
                android:paddingEnd="0dp"
                android:textColor="@color/black87"
                android:textSize="@dimen/xx_small"
                android:text="@string/document_folder_shared_by_str"
                app:layout_constraintHorizontal_bias="0.0"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/labOrderLabPDFNameTV" />
            <TextView
                android:id="@+id/labOrderMemberNameTV"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/common_card_item_margin_vertical"
                android:fontFamily="@font/open_sans_medium"
                android:paddingStart="@dimen/card_padding_half"
                android:paddingEnd="0dp"
                android:textColor="@color/black87"
                android:textSize="@dimen/xx_small"
                app:layout_constraintHorizontal_bias="0.0"
                app:layout_constraintStart_toEndOf="@+id/labOrderSharedByTV"
                app:layout_constraintTop_toBottomOf="@id/labOrderLabPDFNameTV"
                tools:text="Complete Blood Test" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>
</FrameLayout>