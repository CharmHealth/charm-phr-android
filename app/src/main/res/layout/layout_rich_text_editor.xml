<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:id="@+id/richTextToolBarLayout"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:orientation="horizontal"
        app:layout_constraintTop_toTopOf="parent">

        <Button
            android:id="@+id/rteBoldButton"
            style="@style/richTextEditorStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="B" />


        <Button
            android:id="@+id/rteUnderlineButton"
            style="@style/richTextEditorStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="U" />

        <Button
            android:id="@+id/rteItalicButton"
            style="@style/richTextEditorStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="I" />

    </LinearLayout>

    <jp.wasabeef.richeditor.RichEditor
        android:id="@+id/richTextEditor"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        app:layout_constraintTop_toBottomOf="@+id/richTextToolBarLayout" />


</androidx.constraintlayout.widget.ConstraintLayout>

