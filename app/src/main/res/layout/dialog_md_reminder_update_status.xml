<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/reminderStatusUpdateDialogLayout"
    android:maxWidth="500dp"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    app:cardCornerRadius="5dp">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        >
        <TextView
            android:id="@+id/dialogScheduledForTV"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:paddingTop="@dimen/card_padding"
            android:paddingStart="@dimen/card_padding"
            android:paddingEnd="@dimen/card_padding_half"
            android:paddingBottom="@dimen/card_padding"
            android:fontFamily="@font/open_sans"
            android:lineSpacingExtra="@dimen/common_line_height"
            android:textColor="@color/black87"
            android:text="@string/scheduled_for_str"
            android:textSize="@dimen/large"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:id="@+id/dialogScheduledTimeTV"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:fontFamily="@font/open_sans_medium"
            android:textColor="@color/black87"
            android:textSize="@dimen/large"
            android:paddingTop="@dimen/card_padding"
            android:paddingBottom="@dimen/card_padding"
            android:paddingEnd="@dimen/card_padding_half"
            tools:text="10 AM"
            app:layout_constraintStart_toEndOf="@+id/dialogScheduledForTV"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageView
            android:id="@+id/reminderHistoryIV"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingTop="@dimen/card_padding"
            android:paddingEnd="@dimen/card_padding"
            android:paddingStart="@dimen/card_padding"
            android:paddingBottom="@dimen/card_padding"
            android:src="@drawable/ic_history"
            app:layout_constraintEnd_toStartOf="@+id/dialogReminderEdit"
            app:layout_constraintTop_toTopOf="parent">
        </ImageView>
        <ImageView
            android:id="@+id/dialogReminderEdit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingTop="@dimen/card_padding"
            android:paddingEnd="@dimen/card_padding"
            android:paddingStart="@dimen/card_padding"
            android:paddingBottom="@dimen/card_padding"
            android:src="@drawable/ic_edit"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent">
        </ImageView>
        <View
            android:id="@+id/dialogReminderTopSeparator"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/practiceSeparator"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/dialogScheduledForTV">
        </View>
        <LinearLayout
            android:id="@+id/dialogReminderLL"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/dialogReminderTopSeparator">
        </LinearLayout>
        <View
            android:id="@+id/dialogReminderBottomSeparator"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/practiceSeparator"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/dialogReminderLL">
        </View>
        <LinearLayout
            android:id="@+id/dialogReminderStatusLL"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:orientation="horizontal"
            app:layout_constraintTop_toBottomOf="@+id/dialogReminderBottomSeparator">
            <RelativeLayout
                android:id="@+id/dialogSkipRL"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingTop="@dimen/card_padding"
                android:paddingBottom="@dimen/card_padding"
                android:orientation="horizontal"
                android:layout_weight="5"
                app:layout_constraintBottom_toBottomOf="@+id/taskItemAssignByMinExtendedCL"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@+id/taskItemAssignedByTV">

                <TextView
                    android:id="@+id/dialogSkipTV"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerHorizontal="true"
                    android:fontFamily="@font/open_sans_medium"
                    android:paddingTop="2dp"
                    android:paddingEnd="@dimen/card_padding_half"
                    android:text="@string/skip_str"
                    android:textColor="#df1b2b"
                    android:textSize="@dimen/x_medium"
                    android:textStyle="normal" />

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerHorizontal="true"
                    android:layout_marginTop="2dp"
                    android:layout_toRightOf="@+id/dialogSkipTV"
                    android:src="@drawable/ic_close_red"/>
            </RelativeLayout>
            <RelativeLayout
                android:id="@+id/dialogReminderTakenRL"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingTop="@dimen/card_padding"
                android:paddingBottom="@dimen/card_padding"
                android:orientation="horizontal"
                android:layout_weight="5"
                app:layout_constraintBottom_toBottomOf="@+id/taskItemAssignByMinExtendedCL"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@+id/taskItemAssignedByTV">

                <TextView
                    android:id="@+id/dialogReminderTakenTV"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerHorizontal="true"
                    android:fontFamily="@font/open_sans_medium"
                    android:paddingTop="3dp"
                    android:paddingEnd="@dimen/card_padding_half"
                    android:text="@string/taken_str"
                    android:textColor="#27a228"
                    android:textSize="@dimen/x_medium"
                    android:textStyle="normal" />

                <ImageView
                    android:id="@+id/dialogReminderTakenIV"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerHorizontal="true"
                    android:layout_marginTop="2dp"
                    android:layout_toRightOf="@+id/dialogReminderTakenTV"
                    android:src="@drawable/ic_tick_green"/>
            </RelativeLayout>

        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.cardview.widget.CardView>
