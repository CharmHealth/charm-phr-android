<?xml version="1.0" encoding="utf-8"?>

<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/billingPaymentDialog"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@android:color/transparent"
    app:layout_behavior="android.support.design.widget.BottomSheetBehavior"

    >

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/commonBgColor"
        android:clickable="true"
        android:focusable="true"
        android:focusableInTouchMode="true">

        <requestFocus />

        <TextView
            android:id="@+id/billingPaymentAmountLabelTV"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/card_padding"
            android:fontFamily="@font/open_sans"
            android:text="@string/billing_payment_amount_str"
            android:textColor="@color/black87"
            android:textSize="@dimen/medium"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/billingPaymentAmountValueTV"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/open_sans_medium"
            android:textColor="@color/billingColorAmtTxtColor"
            android:textSize="@dimen/billing_payment_dialog_amt_txt_size"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/billingPaymentAmountLabelTV" />
        <TextView
            android:id="@+id/billingPaymentCurrencyTV"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingTop="@dimen/card_padding"
            android:fontFamily="@font/open_sans_medium"
            android:textColor="@color/billingColorAmtTxtColor"
            android:textSize="@dimen/billing_payment_dialog_amt_txt_size"
            tools:text="$"
            android:visibility="gone"
            app:layout_constraintEnd_toStartOf="@+id/billingPaymentEditAmountValueTV"
            app:layout_constraintTop_toBottomOf="@id/billingPaymentAmountValueTV" />
        <com.charm.phr.mphr.ui.components.MDTextInputEdittext
            android:id="@+id/billingPaymentEditAmountValueTV"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:minWidth="30dp"
            android:fontFamily="@font/open_sans_medium"
            android:textColor="@color/billingColorAmtTxtColor"
            android:textSize="@dimen/billing_payment_dialog_amt_txt_size"
            tools:text="34.00"
            android:inputType="numberDecimal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/billingPaymentAmountValueTV"/>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/billingPaymentCardLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="@dimen/edittext_margin_vertical"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/billingPaymentEditAmountValueTV">

            <com.charm.phr.mphr.ui.components.MDTextInputEdittext
                android:id="@+id/billingPaymentCardNameET"
                style="@style/itemCardDetailEdittextTheme"
                android:layout_width="match_parent"
                android:layout_height="@dimen/book_appointment_card_details_height"
                android:layout_marginStart="@dimen/card_padding"
                android:layout_marginTop="@dimen/card_padding"
                android:layout_marginEnd="@dimen/card_padding"
                android:hint="@string/payment_card_name_hint"
                android:imeOptions="actionNext"
                android:inputType="text|textNoSuggestions|textCapWords"
                android:maxLines="1"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:setBgTransparent="false" />

            <com.charm.phr.mphr.ui.components.MDTextInputEdittext
                android:id="@+id/billingPaymentCardNumberET"
                style="@style/itemCardDetailEdittextTheme"
                android:layout_width="match_parent"
                android:layout_height="@dimen/book_appointment_card_details_height"
                android:layout_marginStart="@dimen/card_padding"
                android:layout_marginTop="@dimen/card_padding"
                android:layout_marginEnd="@dimen/card_padding"
                android:hint="@string/payment_card_number_hint"
                android:inputType="number"
                android:maxLength="19"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/billingPaymentCardNameET"
                app:setBgTransparent="false" />

            <com.charm.phr.mphr.ui.components.MDTextInputEdittext
                android:id="@+id/billingPaymentCardNickNameET"
                style="@style/itemCardDetailEdittextTheme"
                android:layout_width="match_parent"
                android:layout_height="@dimen/book_appointment_card_details_height"
                android:layout_marginStart="@dimen/card_padding"
                android:layout_marginTop="@dimen/card_padding_half"
                android:layout_marginEnd="@dimen/card_padding"
                android:layout_marginBottom="@dimen/card_padding_half"
                android:hint="@string/card_nick_name"
                android:imeOptions="actionNext"
                android:inputType="text|textNoSuggestions|textCapWords"
                android:maxLines="1"
                app:layout_constraintBottom_toTopOf="@+id/billingPaymentCardExpiryLayout"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/billingPaymentCardNumberET"
                app:setBgTransparent="false" />

            <LinearLayout
                android:id="@+id/billingPaymentCardExpiryLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingTop="@dimen/card_padding"
                android:weightSum="2"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/billingPaymentCardNickNameET">

                <com.charm.phr.mphr.ui.components.MDClickToSelectEdittext
                    android:id="@+id/billingPaymentCardExpMonthET"
                    style="@style/itemCardDetailEdittextTheme"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/book_appointment_card_details_height"
                    android:layout_marginStart="@dimen/card_padding"
                    android:layout_marginEnd="@dimen/card_padding"
                    android:layout_weight="1"
                    android:hint="@string/payment_card_expiry_month_hint"
                    android:inputType="number"
                    app:setBgTransparent="false" />

                <com.charm.phr.mphr.ui.components.MDClickToSelectEdittext
                    android:id="@+id/billingPaymentCardExpYearET"
                    style="@style/itemCardDetailEdittextTheme"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/book_appointment_card_details_height"
                    android:layout_marginEnd="@dimen/card_padding"
                    android:layout_weight="1"
                    android:hint="@string/payment_card_expiry_year_hint"
                    android:inputType="number"
                    app:setBgTransparent="false" />
            </LinearLayout>

            <com.charm.phr.mphr.ui.components.MDTextInputEdittext
                android:id="@+id/billingPaymentCardCvvET"
                style="@style/itemCardDetailEdittextTheme"
                android:layout_width="0dp"
                android:layout_height="@dimen/book_appointment_card_details_height"
                android:layout_margin="@dimen/card_padding"
                android:hint="@string/payment_card_cvv_hint"
                android:imeOptions="actionDone"
                android:inputType="number"
                android:maxLength="4"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/billingPaymentCardExpiryLayout"
                app:layout_constraintWidth_percent=".464"
                app:setBgTransparent="false" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <LinearLayout
            android:id="@+id/billingPaymentChooseCardLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/billingPaymentCardLayout">

            <TextView
                android:id="@+id/billingPaymentChooseCardTV"
                style="@style/itemEdittextHeadingTheme"
                android:text="@string/choose_card" />

            <com.charm.phr.mphr.ui.components.MDClickToSelectEdittext
                android:id="@+id/billingPaymentChooseCardET"
                style="@style/itemEdittextTheme"
                android:layout_marginTop="@dimen/edittext_margin_vertical"
                android:hint="@string/select_str"
                android:inputType="text|textNoSuggestions"
                app:showIcon="true" />

        </LinearLayout>

        <Button
            style="@style/mdButtonStyle"
            android:id="@+id/billingPaymentBtn"
            android:layout_width="match_parent"
            android:layout_height="@dimen/add_button_height"
            android:layout_margin="@dimen/card_padding"
            android:background="@drawable/item_button_bg"
            android:fontFamily="@font/open_sans_medium"
            android:text="@string/billing_payment_make_payment_str"
            android:textColor="@android:color/white"
            android:textSize="@dimen/xx_large"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/billingPaymentChooseCardLayout" />


    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>


