<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/card_margin_horizontal"
    android:layout_marginEnd="@dimen/card_margin_horizontal"
    android:layout_marginBottom="@dimen/card_padding"
    android:background="@drawable/item_questionnaire_bg"
    android:elevation="1dp">

    <TextView
        android:id="@+id/questionnaireDetailItemQuesAnsHint"
        style="@style/itemQuestionnaireHint"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="Question" />

    <com.charm.phr.mphr.ui.components.MDTextInputEdittext

        android:id="@+id/questionnaireDetailItemQuesAnsET"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/card_padding"
        android:layout_marginTop="@dimen/questionnaire_detail_ques_ans_value_margin_top"
        android:layout_marginEnd="@dimen/card_padding"
        android:layout_marginBottom="@dimen/card_padding"
        android:background="@drawable/item_questionnaire_option_other"
        android:fontFamily="@font/open_sans"
        android:gravity="start|top"
        android:inputType="text|textCapSentences|textNoSuggestions|textMultiLine"
        android:minHeight="@dimen/questionnaire_detail_simple_ques_ans_value_height"
        android:padding="@dimen/questionnaire_detail_ques_ans_value_padding"
        android:textColor="@color/edittext_txt_color"
        android:textSize="@dimen/font_size_for_edittext"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/questionnaireDetailItemQuesAnsHint"
        app:setBgTransparent="false"
        tools:text="Answer" />

</androidx.constraintlayout.widget.ConstraintLayout>