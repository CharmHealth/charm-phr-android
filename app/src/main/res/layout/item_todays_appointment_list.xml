<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/homePageTodaysAppointmentListMainView"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="15dp"
    android:clickable="true"
    android:focusable="true"
    android:paddingStart="@dimen/dashboard_card_padding"
    android:paddingEnd="@dimen/dashboard_card_padding">

    <com.charm.phr.mphr.ui.components.MDmPHRConstraintLayout

        android:id="@+id/todayAppointmentSeparator"
        android:layout_width="4dp"
        android:layout_height="20dp"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="2dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:mdBackgroundColor="@color/todayAppointmentSeparatorColor" />

    <TextView
        android:id="@+id/todayAppointmentMemberName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="5dp"
        android:fontFamily="@font/open_sans_medium"
        android:gravity="top"
        android:paddingStart="@dimen/dashboard_card_padding"
        android:paddingEnd="@dimen/dashboard_card_padding"
        android:textColor="@color/black87"
        android:textSize="@dimen/xx_small"
        app:layout_constraintBottom_toTopOf="@id/todayAppointmentFacilityName"
        app:layout_constraintEnd_toStartOf="@id/todayAppointmentStartTimeTV"
        app:layout_constraintStart_toEndOf="@id/todayAppointmentSeparator"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="Dr. William Amerthnet" />

    <TextView
        android:id="@+id/todayAppointmentFacilityName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:ellipsize="end"
        android:fontFamily="@font/open_sans"
        android:maxLines="2"
        android:paddingStart="@dimen/dashboard_card_padding"
        android:paddingEnd="0dp"
        android:textColor="@color/black87"
        android:textSize="@dimen/x_small"
        app:layout_constraintEnd_toStartOf="@id/todayAppointmentBtnLayout"
        app:layout_constraintStart_toEndOf="@id/todayAppointmentSeparator"
        app:layout_constraintTop_toBottomOf="@id/todayAppointmentMemberName"
        tools:text="Malar Hospital" />

    <TextView
        android:id="@+id/todayAppointmentTimezoneTV"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:fontFamily="@font/open_sans"
        android:paddingStart="@dimen/dashboard_card_padding"
        android:paddingEnd="0dp"
        android:textColor="@color/black87"
        android:textSize="@dimen/x_small"
        app:layout_constraintEnd_toStartOf="@id/todayAppointmentBtnLayout"
        app:layout_constraintStart_toEndOf="@id/todayAppointmentSeparator"
        app:layout_constraintTop_toBottomOf="@id/todayAppointmentFacilityName"
        tools:text="5:00 AM" />

    <TextView
        android:id="@+id/todayAppointmentStartTimeTV"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/open_sans_medium"
        android:textColor="@color/black87"
        android:textSize="@dimen/xx_small"
        app:layout_constraintBottom_toBottomOf="@id/todayAppointmentMemberName"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/todayAppointmentMemberName"
        tools:text="10 : 00 AM" />

    <LinearLayout
        android:id="@+id/todayAppointmentBtnLayout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/card_padding"
        android:layout_marginBottom="@dimen/card_padding_half"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="@id/todayAppointmentTimezoneTV"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/todayAppointmentFacilityName"
        app:layout_constraintVertical_bias="1">

        <com.charm.phr.mphr.ui.components.MDmPHRConstraintLayout
            android:id="@+id/todayAppointmentVideoCamLayout"
            android:layout_width="64dp"
            android:layout_height="28dp"
            android:paddingStart="@dimen/card_padding"
            android:paddingEnd="@dimen/card_padding"

            android:visibility="gone"
            app:mdBackgroundColor="@color/colorPrimary"
            app:mdCornerRadius="5dp"
            tools:visibility="visible">

            <ImageView
                android:id="@+id/todayAppointmentVideoCamImg"
                android:layout_width="15dp"
                android:layout_height="15dp"
                android:src="@drawable/ic_videocam_white"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginStart="4dp"
                android:fontFamily="@font/open_sans_medium"
                android:gravity="center_vertical"
                android:text="@string/join_str"
                android:textAllCaps="true"
                android:textColor="@color/textColorForColorPrimaryBg"
                android:textSize="@dimen/small"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/todayAppointmentVideoCamImg"
                app:layout_constraintTop_toTopOf="parent" />
        </com.charm.phr.mphr.ui.components.MDmPHRConstraintLayout>

        <com.charm.phr.mphr.ui.components.MDmPHRConstraintLayout
            android:id="@+id/todayAppointmentQuestionnaireLayout"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:layout_marginStart="@dimen/card_padding"
            android:paddingStart="@dimen/card_padding"
            android:paddingTop="@dimen/card_padding_half"
            android:paddingEnd="@dimen/card_padding"
            android:paddingBottom="@dimen/card_padding_half"
            android:visibility="gone"
            app:mdBackgroundColor="@color/colorPrimary"
            app:mdCornerRadius="5dp"
            tools:visibility="visible">

            <TextView
                android:id="@+id/todayAppointmentQuestionnaireTV"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginStart="4dp"
                android:fontFamily="@font/open_sans_medium"
                android:gravity="center_vertical"
                android:text="@string/fill_questionnaire_txt"
                android:textAllCaps="true"
                android:textColor="@android:color/white"
                android:textSize="@dimen/x_small"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/todayAppointmentVideoCamImg"
                app:layout_constraintTop_toTopOf="parent" />
        </com.charm.phr.mphr.ui.components.MDmPHRConstraintLayout>

    </LinearLayout>


</androidx.constraintlayout.widget.ConstraintLayout>