<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/questionnaireMainLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/commonBgColor"
    tools:context=".ui.questionnaire.QuestionnaireActivity">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/questionnaireToolbar"
        android:layout_width="match_parent"
        android:layout_height="?actionBarSize"
        android:background="@color/toolbarBg"
        android:elevation="@dimen/tab_elevation"
        app:contentInsetStart="0dp"
        app:contentInsetStartWithNavigation="0dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <ImageButton
                android:id="@+id/questionnaireBackBtn"
                android:layout_width="@dimen/toolBarBtnWd"
                android:layout_height="match_parent"
                android:layout_gravity="start"
                android:background="?selectableItemBackgroundBorderless"
                android:src="@drawable/ic_arrow_back_white"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/questionnaireToolbarText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/toolbar_text_left_margin"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/questionnaire_str"
                android:textAppearance="@style/toolbarText"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@id/questionnaireBackBtn"
                app:layout_constraintTop_toTopOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>


    </androidx.appcompat.widget.Toolbar>


    <FrameLayout
        android:id="@+id/questionnaireInfoLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/ic_info_bg"
        android:layout_marginStart="@dimen/dashboard_card_margin"
        android:layout_marginTop="@dimen/common_margin_vertical"
        android:layout_marginEnd="@dimen/dashboard_card_margin"
        android:layout_marginBottom="@dimen/common_margin_vertical_half"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/questionnaireToolbar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/card_padding_half"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_info" />

            <TextView
                android:id="@+id/questionnaireInfoTextTV"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/consent_form_info"
                android:textSize="@dimen/xx_small"
                android:textAppearance="@style/dateDisplayTxtAppearance" />

        </LinearLayout>

    </FrameLayout>

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/questionnaireTabLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/colorPrimary"
        android:elevation="@dimen/tab_elevation"
        android:textAlignment="center"
        app:layout_behavior="@string/appbar_scrolling_view_behavior"
        app:layout_constraintTop_toBottomOf="@id/questionnaireInfoLayout"
        app:tabBackground="@drawable/item_ripple_color_primary_bg"
        app:tabGravity="fill"
        app:tabIndicatorColor="@color/tabIndicator"
        app:tabIndicatorHeight="@dimen/tab_indicator_height"
        app:tabMaxWidth="0dp"
        app:tabMinWidth="0dp"
        app:tabMode="fixed"
        app:tabPaddingEnd="10dp"
        app:tabPaddingStart="10dp"
        app:tabRippleColor="@color/whiteRipple"
        app:tabSelectedTextColor="@color/tabSelectedTxtColor"
        app:tabTextAppearance="@style/tabText"
        app:tabTextColor="@color/tabTxtColor" />

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/questionnaireViewPager"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="@color/commonBgColor"
        app:layout_constraintBottom_toTopOf="@id/questionnaireJoinVideoCallBtn"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/questionnaireTabLayout" />

    <Button
        android:id="@+id/questionnaireJoinVideoCallBtn"
        android:layout_width="match_parent"
        android:layout_height="@dimen/add_button_height"
        android:layout_marginStart="@dimen/button_margin"
        android:layout_marginEnd="@dimen/button_margin"
        android:layout_marginBottom="@dimen/card_padding_half"
        android:background="@drawable/item_button_bg"
        android:enabled="false"
        android:fontFamily="@font/open_sans_medium"
        android:text="@string/tp_join_meeting_str"
        android:textColor="@android:color/white"
        android:textSize="@dimen/medium"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />


</androidx.constraintlayout.widget.ConstraintLayout>


