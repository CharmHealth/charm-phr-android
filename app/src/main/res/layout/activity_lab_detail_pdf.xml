<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/labDetailPdfMainLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.lab.detail_pdf.LabDetailPDFActivity">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/labDetailPDFToolbar"
        android:layout_width="match_parent"
        android:layout_height="?actionBarSize"
        android:background="@color/toolbarBg"
        app:contentInsetStart="0dp"
        app:contentInsetStartWithNavigation="0dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            >
            <ImageButton
                android:id="@+id/labDetailPDFBackBtn"
                android:layout_width="@dimen/toolBarBtnWd"
                android:layout_height="match_parent"
                android:layout_gravity="start"
                android:background="?selectableItemBackgroundBorderless"
                android:src="@drawable/ic_arrow_back_white"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>

            <TextView
                android:id="@+id/labDetailPDFToolbarText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/toolbar_text_left_margin"
                android:focusable="true"
                android:maxLines="1"
                android:ellipsize="end"
                android:focusableInTouchMode="true"
                android:text="@string/lab_report_str"
                android:textAppearance="@style/toolbarText"
                tools:text="ewfef fweewf efwef ewfewf ewfwef ewf ewfwefwef ewfwef"
                app:layout_constraintStart_toEndOf="@+id/labDetailPDFBackBtn"
                app:layout_constraintEnd_toStartOf="@+id/labDetailPDFShareBtn"
                app:layout_constraintTop_toTopOf="parent"/>

            <ImageButton
                android:id="@+id/labDetailPDFShareBtn"
                android:layout_width="@dimen/toolBarBtnWd"
                android:layout_height="match_parent"
                android:layout_gravity="end"
                android:background="?selectableItemBackgroundBorderless"
                android:src="@drawable/ic_share"
                android:visibility="visible"
               app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.appcompat.widget.Toolbar>


    <include
        android:id="@+id/labDetailPDFErrorPage"
        layout="@layout/layout_error_page"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/labDetailPDFToolbar" />

    <include
        android:id="@+id/labDetailPDFProgress"
        layout="@layout/layout_progress_bar"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/labDetailPDFToolbar" />

    <include
        android:id="@+id/labDetailPDFNoDataTV"
        layout="@layout/layout_no_data"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/labDetailPDFToolbar" />

    <com.rajat.pdfviewer.PdfRendererView
        android:id="@+id/labDetailPDFPDFViewer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="@dimen/card_margin_horizontal"
        android:layout_marginTop="@dimen/billing_detail_item_margin_top"
        android:layout_marginEnd="@dimen/card_margin_horizontal"
        android:layout_marginBottom="@dimen/card_margin_horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/labDetailPDFToolbar"
        app:pdfView_showDivider="false" />
</androidx.constraintlayout.widget.ConstraintLayout>