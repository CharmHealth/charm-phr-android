<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/dashboard_card_padding"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical"
    android:paddingStart="@dimen/dashboard_card_padding"
    android:paddingEnd="@dimen/dashboard_card_padding">

    <com.charm.phr.mphr.ui.components.MDmPHRConstraintLayout
        android:id="@+id/homePageInvoiceDateAndDayLayout"
        android:layout_width="44dp"
        android:layout_height="52dp"
        android:layout_marginTop="2.5dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:mdBackgroundColor="@color/colorPrimary"
        app:mdCornerRadius="6dp">

        <TextView
            android:id="@+id/homePageInvoiceDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/open_sans_bold"
            android:textColor="@android:color/white"
            android:textSize="@dimen/xx_medium"
            app:layout_constraintBottom_toTopOf="@id/homePageInvoiceMonth"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="26" />

        <TextView
            android:id="@+id/homePageInvoiceMonth"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:fontFamily="@font/open_sans_medium"
            android:textColor="@android:color/white"
            android:textSize="@dimen/small"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/homePageInvoiceDate"

            tools:text="Jan" />


    </com.charm.phr.mphr.ui.components.MDmPHRConstraintLayout>


    <TextView
        android:id="@+id/homePageInvoiceHeading"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dashboard_card_padding"
        android:layout_marginEnd="@dimen/dashboard_card_padding"
        android:layout_weight="1"
        android:ellipsize="middle"
        android:fontFamily="@font/open_sans_medium"
        android:singleLine="true"
        android:textColor="@color/black87"
        android:textSize="@dimen/xx_small"
        app:layout_constraintBottom_toTopOf="@id/homePageInvoiceFacilityName"
        app:layout_constraintEnd_toStartOf="@id/homePageInvoiceAmount"
        app:layout_constraintStart_toEndOf="@id/homePageInvoiceDateAndDayLayout"
        app:layout_constraintTop_toTopOf="@+id/homePageInvoiceDateAndDayLayout"
        app:layout_constraintVertical_chainStyle="packed"
        tools:text="Payment Requested" />

    <TextView
        android:id="@+id/homePageInvoiceFacilityName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dashboard_card_padding"
        android:layout_marginTop="@dimen/common_card_item_margin_vertical"
        android:layout_marginEnd="@dimen/dashboard_card_padding"
        android:ellipsize="end"
        android:fontFamily="@font/open_sans"
        android:gravity="top"
        android:maxLines="2"
        android:letterSpacing="0.005"
        android:textColor="@color/upcomingAppointmentFacilityNameTxtColor"
        android:textSize="@dimen/x_small"
        app:layout_constraintBottom_toBottomOf="@+id/homePageInvoiceDateAndDayLayout"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/homePageInvoiceDateAndDayLayout"
        app:layout_constraintTop_toBottomOf="@id/homePageInvoiceHeading"

        tools:text="Charm Health Clinic" />


    <TextView
        android:id="@+id/homePageInvoiceAmount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/open_sans_medium"
        android:textColor="@color/allergyListSeveritySevereTxtColor"
        android:textSize="@dimen/medium"
        app:layout_constraintBottom_toBottomOf="@id/homePageInvoiceHeading"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/homePageInvoiceHeading"
        tools:text="$ 50.00" />


</androidx.constraintlayout.widget.ConstraintLayout>
