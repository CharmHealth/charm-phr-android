<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="@android:color/white"
    app:cardCornerRadius="@dimen/common_card_radius"
    app:cardElevation="@dimen/common_card_elevation">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/healthGridListConstraintLayout"
        android:layout_width="match_parent"
        android:layout_height="168dp"
        android:background="@drawable/item_ripple_grid_bg">

        <ImageView
            android:id="@+id/healthGridListIcon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dashboard_card_padding"
            android:layout_marginEnd="@dimen/dashboard_card_padding"
            app:layout_constraintBottom_toTopOf="@id/healthGridListNxtBtn"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.3"
            tools:src="@drawable/ic_hp_medication" />

        <TextView
            android:id="@+id/healthGridListName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dashboard_card_padding"
            android:layout_marginEnd="@dimen/dashboard_card_padding"
            android:fontFamily="@font/open_sans_medium"
            android:gravity="bottom"
            android:textColor="@color/colorPrimary"
            android:textSize="@dimen/medium"
            app:layout_constraintBottom_toBottomOf="@id/healthGridListNxtBtn"
            app:layout_constraintEnd_toStartOf="@id/healthGridListNxtBtn"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/healthGridListNxtBtn"
            tools:text="HSHSHS" />

        <TextView

            android:id="@+id/healthGridListNotificationTV"
            style="@style/notificationItem"
            android:layout_marginTop="@dimen/dashboard_card_padding"
            android:layout_marginEnd="@dimen/dashboard_card_padding"
            app:layout_constraintBottom_toTopOf="@id/healthGridListNxtBtn"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0"
            tools:text="123" />

        <ImageView
            android:id="@+id/healthGridListNxtBtn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/dashboard_card_padding"
            android:layout_marginBottom="@dimen/dashboard_card_padding"
            android:src="@drawable/ic_hp_nav_next"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.cardview.widget.CardView>
