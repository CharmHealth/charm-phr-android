<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/practiceSeparator" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/practice_label_margin_top"
        android:fontFamily="@font/open_sans"
        android:text="@string/practice_str"
        android:textColor="@android:color/black"
        android:textSize="@dimen/x_small" />

    <TextView
        android:id="@+id/practiceDetailTV"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/common_card_item_margin_vertical"
        android:fontFamily="@font/open_sans_medium"
        android:textColor="@color/black80"
        android:textSize="@dimen/x_small" />


</LinearLayout>