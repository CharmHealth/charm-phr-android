<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/signatureDialogLayout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    app:cardCornerRadius="5dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/questionnaire_card_margin_vertical">

        <TextView
            android:id="@+id/questionnaireDetailItemSignatureHint"
            style="@style/itemQuestionnaireHint"
            android:layout_marginStart="@dimen/card_margin_horizontal"
            android:text="@string/signature_str"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageButton
            android:id="@+id/signatureClose"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/item_ripple_buttons"
            android:paddingStart="@dimen/card_margin_horizontal"
            android:paddingTop="@dimen/card_padding"
            android:paddingEnd="25dp"
            android:paddingBottom="@dimen/card_padding"
            android:src="@drawable/ic_close_24"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/questionnaireDetailItemSignatureLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/card_margin_horizontal"
            android:layout_marginTop="@dimen/card_padding"
            android:layout_marginEnd="@dimen/card_margin_horizontal"
            android:layout_marginBottom="@dimen/card_margin_horizontal"
            android:background="@drawable/item_questionnaire_bg"
            android:elevation="1dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/questionnaireDetailItemSignatureHint">

            <com.github.gcacace.signaturepad.views.SignaturePad
                android:id="@+id/questionnaireDetailItemSignaturePad"
                android:layout_width="match_parent"
                android:layout_height="150dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:penColor="@android:color/black" />


            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/questionnaireDetailItemSignatureGuideLine"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_constraintGuide_percent=".5" />


            <com.google.android.material.button.MaterialButton
                android:id="@+id/questionnaireDetailItemSignatureSaveBtn"
                android:layout_width="0dp"
                android:layout_height="@dimen/secondary_btn_height"
                android:layout_marginStart="@dimen/card_padding_half"
                android:layout_marginTop="@dimen/card_padding"
                android:layout_marginEnd="@dimen/card_padding"
                android:layout_marginBottom="@dimen/card_padding"
                android:fontFamily="@font/open_sans_medium"
                android:text="@string/save_signature_txt"
                android:textColor="@android:color/white"
                android:textSize="@dimen/medium"
                app:backgroundTint="@color/colorPrimary"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/questionnaireDetailItemSignatureGuideLine"
                app:layout_constraintTop_toBottomOf="@id/questionnaireDetailItemSignatureSeparator" />


            <View
                android:id="@+id/questionnaireDetailItemSignatureSeparator"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/separatorColor"
                app:layout_constraintTop_toBottomOf="@id/questionnaireDetailItemSignaturePad" />


            <com.google.android.material.button.MaterialButton

                android:id="@+id/questionnaireDetailItemSignatureClearBtn"
                android:layout_width="0dp"
                android:layout_height="@dimen/secondary_btn_height"
                android:layout_marginStart="@dimen/card_padding"
                android:layout_marginTop="@dimen/card_padding"
                android:layout_marginEnd="@dimen/card_padding_half"
                android:layout_marginBottom="@dimen/card_padding"
                android:fontFamily="@font/open_sans_medium"
                android:padding="0dp"
                android:text="@string/clear_signature_txt"
                android:textColor="@color/colorPrimary"
                android:textSize="@dimen/medium"
                app:backgroundTint="@android:color/white"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@id/questionnaireDetailItemSignatureGuideLine"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/questionnaireDetailItemSignatureSeparator"
                app:strokeColor="@color/colorPrimary"
                app:strokeWidth="1dp" />

        </androidx.constraintlayout.widget.ConstraintLayout>


    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.cardview.widget.CardView>