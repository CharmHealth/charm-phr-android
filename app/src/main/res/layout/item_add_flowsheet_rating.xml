<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <com.google.android.material.slider.Slider
        style="@style/MDSliderStyle"
        android:layout_width="0dp"
        android:layout_height="40dp"
        android:layout_marginTop="@dimen/card_padding"
        android:layout_marginBottom="@dimen/card_padding"
        android:layout_weight="1"
        android:stepSize="1"
        app:thumbColor="@android:color/white"
        app:thumbElevation="5dp"
        android:focusable="true"
        app:tickVisible="false"
        app:trackColorActive="@color/colorPrimary"
        app:trackColorInactive="#cce6e6e6"
        app:trackHeight="8dp" />

    <TextView
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_gravity="bottom"
        android:layout_marginEnd="@dimen/card_padding"
        android:layout_marginBottom="@dimen/card_padding"
        android:background="@drawable/item_rating_scale_value_bg"
        android:fontFamily="@font/open_sans_medium"
        android:gravity="center"
        android:textColor="@color/black87"
        android:textSize="@dimen/xx_medium"
        tools:text="8" />

</LinearLayout>


