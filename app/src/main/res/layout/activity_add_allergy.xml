<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/addAllergyRootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.allergy.addAllergy.AddAllergyActivity">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/addAllergyToolbar"
        android:layout_width="match_parent"
        android:layout_height="?actionBarSize"
        android:background="@color/toolbarBg"
        app:contentInsetStart="0dp"
        app:contentInsetStartWithNavigation="0dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">


        <ImageButton
            android:id="@+id/addAllergyBackBtn"
            android:layout_width="@dimen/toolBarBtnWd"
            android:layout_height="match_parent"
            android:layout_gravity="start"
            android:background="?selectableItemBackgroundBorderless"
            android:src="@drawable/ic_arrow_back_white" />

        <TextView
            android:id="@+id/addAllergyToolbarText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/toolbar_text_left_margin"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:text="@string/allergy_add_toolbar_str"
            android:textAppearance="@style/toolbarText" />

        <ImageButton
            android:id="@+id/addAllergyDeleteBtn"
            android:layout_width="@dimen/toolBarBtnWd"
            android:layout_height="match_parent"
            android:layout_gravity="end"
            android:background="?selectableItemBackgroundBorderless"
            android:src="@drawable/ic_delete_white"
            android:visibility="gone" />
    </androidx.appcompat.widget.Toolbar>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="@color/commonBgColor"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/addAllergyToolbar">

        <include
            android:id="@+id/addAllergyProgress"
            layout="@layout/progress_bar_for_white_bg"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <include
            android:id="@+id/addAllergyErrorPage"
            layout="@layout/layout_error_page"
            android:visibility="gone" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/addAllergyMainLayout"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ScrollView
                android:id="@+id/addAllergyScrollLayout"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                app:layout_constraintBottom_toTopOf="@id/addAllergyBtn"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:animateLayoutChanges="true"
                    android:orientation="vertical"
                    android:paddingTop="5dp"
                    android:paddingBottom="5dp">

                    <com.charm.phr.mphr.ui.components.MDTextInputLayout
                        android:id="@+id/addAllergyPracticeLayout"
                        style="@style/itemTextInputLayoutTheme"
                        app:hintTextAppearance="@style/itemEdittextHintTxtAppearance">

                        <com.charm.phr.mphr.ui.components.MDClickToSelectEdittext
                            android:id="@+id/addAllergyPracticeET"
                            style="@style/itemTextInputEdittextTheme"
                            android:hint="@string/practice_name_str" />

                    </com.charm.phr.mphr.ui.components.MDTextInputLayout>


                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/addAllergyNameLayout"
                        style="@style/itemTextInputLayoutTheme"
                        app:hintTextAppearance="@style/itemEdittextHintTxtAppearance">

                        <com.charm.phr.mphr.ui.components.MDTextInputEdittext
                            android:id="@+id/addAllergyNameET"
                            style="@style/itemTextInputEdittextTheme"
                            android:hint="@string/allergy_add_allergen_hint"
                            android:maxLength="@integer/addAllergyNameMaxLength"
                            app:filterRegex="alphabets"
                            tools:text="Demo" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <com.charm.phr.mphr.ui.components.MDTextInputLayout
                        android:id="@+id/addAllergyTypeLayout"
                        style="@style/itemTextInputLayoutTheme"
                        app:hintTextAppearance="@style/itemEdittextHintTxtAppearance">

                        <com.charm.phr.mphr.ui.components.MDClickToSelectEdittext
                            android:id="@+id/addAllergyTypeET"
                            style="@style/itemTextInputEdittextTheme"
                            android:hint="@string/allergy_add_type_hint"
                            app:allowAutoSelect="true"
                            tools:text="nuifwe" />

                    </com.charm.phr.mphr.ui.components.MDTextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/addAllergyOtherTypeLayout"
                        style="@style/itemTextInputLayoutTheme"
                        android:visibility="gone"
                        app:hintTextAppearance="@style/itemEdittextHintTxtAppearance">

                        <com.charm.phr.mphr.ui.components.MDTextInputEdittext
                            android:id="@+id/addAllergyOtherTypeET"
                            style="@style/itemTextInputEdittextTheme"
                            android:hint="@string/allergy_add_other_type_hint" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <com.charm.phr.mphr.ui.components.MDTextInputLayout
                        android:id="@+id/addAllergySeverityLayout"
                        style="@style/itemTextInputLayoutTheme"
                        app:hintTextAppearance="@style/itemEdittextHintTxtAppearance">

                        <com.charm.phr.mphr.ui.components.MDClickToSelectEdittext
                            android:id="@+id/addAllergySeverityET"
                            style="@style/itemTextInputEdittextTheme"
                            android:hint="@string/allergy_add_severity_hint"
                            app:allowAutoSelect="true" />

                    </com.charm.phr.mphr.ui.components.MDTextInputLayout>

                    <com.charm.phr.mphr.ui.components.MDTextInputLayout
                        android:id="@+id/addAllergyStatusLayout"
                        style="@style/itemTextInputLayoutTheme"
                        app:hintTextAppearance="@style/itemEdittextHintTxtAppearance">

                        <com.charm.phr.mphr.ui.components.MDClickToSelectEdittext
                            android:id="@+id/addAllergyStatusET"
                            style="@style/itemTextInputEdittextTheme"
                            android:hint="@string/allergy_add_status_hint"
                            app:allowAutoSelect="true" />

                    </com.charm.phr.mphr.ui.components.MDTextInputLayout>

                    <com.charm.phr.mphr.ui.components.MDTextInputLayout
                        android:id="@+id/addAllergyObservedOnLayout"
                        style="@style/itemTextInputLayoutTheme"
                        app:hintTextAppearance="@style/itemEdittextHintTxtAppearance"
                        app:mdShowDropdown="false">

                        <com.charm.phr.mphr.ui.components.MDTextInputEdittext
                            android:id="@+id/addAllergyObservedOnET"
                            style="@style/itemTextInputEdittextTheme"
                            android:drawableEnd="@drawable/ic_calander"
                            android:hint="@string/allergy_add_observed_on_hint" />

                    </com.charm.phr.mphr.ui.components.MDTextInputLayout>

                    <com.charm.phr.mphr.ui.components.MDTextInputLayout
                        android:id="@+id/addAllergyResolvedOnLayout"
                        style="@style/itemTextInputLayoutTheme"
                        android:visibility="gone"
                        app:hintTextAppearance="@style/itemEdittextHintTxtAppearance"
                        app:mdShowDropdown="false">

                        <com.charm.phr.mphr.ui.components.MDTextInputEdittext
                            android:id="@+id/addAllergyResolvedOnET"
                            style="@style/itemTextInputEdittextTheme"
                            android:drawableEnd="@drawable/ic_calander"
                            android:hint="@string/resolved_on_hint" />

                    </com.charm.phr.mphr.ui.components.MDTextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/addAllergyReactionsLayout"
                        style="@style/itemTextInputLayoutTheme"
                        android:layout_height="wrap_content"
                        android:minHeight="@dimen/textinput_edittext_height"
                        app:helperTextTextAppearance="@style/itemEdittextHelperTxtAppearance"
                        app:hintTextAppearance="@style/itemEdittextHintTxtAppearance">

                        <com.charm.phr.mphr.ui.components.MDTextInputEdittext
                            android:id="@+id/addAllergyReactionsET"
                            style="@style/itemTextInputEdittextMultiLineTheme"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="@string/allergy_add_reactions_hint"
                            android:maxLength="@integer/addAllergyReactionsMaxLength" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
            </ScrollView>

            <Button
                android:id="@+id/addAllergyBtn"
                style="@style/mdButtonStyle"
                android:layout_width="match_parent"
                android:layout_height="@dimen/add_button_height"
                android:layout_margin="@dimen/button_margin"
                android:background="@drawable/item_button_bg"
                android:fontFamily="@font/open_sans_medium"
                android:text="@string/add_allergy_btn_txt"
                android:textColor="@android:color/white"
                android:textSize="@dimen/large"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>


</androidx.constraintlayout.widget.ConstraintLayout>