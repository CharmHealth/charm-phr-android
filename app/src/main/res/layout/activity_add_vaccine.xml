<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/addVaccineRootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.vaccine.add_vaccine.AddVaccineActivity">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/addVaccineToolbar"
        android:layout_width="match_parent"
        android:layout_height="?actionBarSize"
        android:background="@color/toolbarBg"
        app:contentInsetStart="0dp"
        app:contentInsetStartWithNavigation="0dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">


        <ImageButton
            android:id="@+id/addVaccineBackBtn"
            android:layout_width="@dimen/toolBarBtnWd"
            android:layout_height="match_parent"
            android:layout_gravity="start"
            android:background="?selectableItemBackgroundBorderless"
            android:src="@drawable/ic_arrow_back_white" />

        <TextView
            android:id="@+id/addVaccineToolbarText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/toolbar_text_left_margin"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:text="@string/vaccine_add_str"
            android:textAppearance="@style/toolbarText" />

        <ImageButton
            android:id="@+id/addVaccineDeleteBtn"
            android:layout_width="@dimen/toolBarBtnWd"
            android:layout_height="match_parent"
            android:layout_gravity="end"
            android:background="?selectableItemBackgroundBorderless"
            android:src="@drawable/ic_delete_white"
            android:visibility="gone" />
    </androidx.appcompat.widget.Toolbar>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="@color/commonBgColor"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/addVaccineToolbar">


        <include
            android:id="@+id/addVaccineProgress"
            layout="@layout/progress_bar_for_white_bg"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <include
            android:id="@+id/addVaccineErrorPage"
            layout="@layout/layout_error_page"
            android:visibility="gone" />


        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/addVaccineMainLayout"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ScrollView
                android:id="@+id/addVaccineScrollView"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginBottom="@dimen/button_margin"
                app:layout_constraintBottom_toTopOf="@id/addVaccineBtn"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingTop="5dp"
                    android:paddingBottom="5dp">


                    <com.charm.phr.mphr.ui.components.MDTextInputLayout
                        android:id="@+id/addVaccinePracticeLayout"
                        style="@style/itemTextInputLayoutTheme"
                        app:hintTextAppearance="@style/itemEdittextHintTxtAppearance">

                        <com.charm.phr.mphr.ui.components.MDClickToSelectEdittext
                            android:id="@+id/addVaccinePracticeET"
                            style="@style/itemTextInputEdittextTheme"
                            android:hint="@string/practice_name_str" />

                    </com.charm.phr.mphr.ui.components.MDTextInputLayout>

                    <RadioGroup
                        android:id="@+id/addVaccineTypeRadioGrp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:weightSum="2"

                        >

                        <RadioButton
                            android:id="@+id/addVaccineTypeChildhood"
                            android:layout_width="0dp"
                            android:layout_height="57dp"
                            android:layout_marginStart="@dimen/edittext_margin_horizontal"
                            android:layout_marginTop="@dimen/edittext_margin_vertical"
                            android:layout_marginEnd="@dimen/edittext_margin_horizontal"
                            android:layout_marginBottom="@dimen/edittext_margin_vertical"
                            android:layout_weight="1"
                            android:background="@drawable/item_edittext_bg"
                            android:buttonTint="@color/colorAccent"
                            android:checked="true"
                            android:elevation="1dp"
                            android:fontFamily="@font/open_sans"
                            android:text="@string/add_vaccine_type_childhood"
                            android:textSize="@dimen/medium"

                            />

                        <RadioButton
                            android:id="@+id/addVaccineTypeAdolescent"
                            android:layout_width="0dp"
                            android:layout_height="57dp"
                            android:layout_marginTop="@dimen/edittext_margin_vertical"
                            android:layout_marginEnd="@dimen/edittext_margin_horizontal"
                            android:layout_marginBottom="@dimen/edittext_margin_vertical"
                            android:layout_weight="1"
                            android:background="@drawable/item_edittext_bg"
                            android:buttonTint="@color/colorAccent"
                            android:elevation="1dp"
                            android:fontFamily="@font/open_sans"
                            android:text="@string/add_vaccine_type_adolescent"
                            android:textSize="@dimen/medium" />
                    </RadioGroup>


                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/addVaccineNameLayout"
                        style="@style/itemTextInputLayoutTheme"
                        app:hintTextAppearance="@style/itemEdittextHintTxtAppearance"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent">

                        <com.charm.phr.mphr.ui.components.MDTextInputAutoCompleteTextView

                            android:id="@+id/addVaccineNameET"
                            style="@style/itemTextInputEdittextTheme"
                            android:completionThreshold="1"
                            android:dropDownAnchor="@id/addVaccineNameLayout"
                            android:hint="@string/vaccine_name_str"
                            android:maxLength="@integer/addVaccineNameMaxLength"

                            />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/addVaccineManufacturerLayout"
                        style="@style/itemTextInputLayoutTheme"
                        app:hintTextAppearance="@style/itemEdittextHintTxtAppearance">

                        <com.charm.phr.mphr.ui.components.MDTextInputEdittext
                            android:id="@+id/addVaccineManufacturerET"
                            style="@style/itemTextInputEdittextTheme"
                            android:hint="@string/vaccine_manufacturer_label"
                            android:maxLength="@integer/addVaccineManufacturerMaxLength"
                            app:filterRegex="alphabets" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <com.charm.phr.mphr.ui.components.MDTextInputLayout
                        android:id="@+id/addVaccineDateLayout"
                        style="@style/itemTextInputLayoutTheme"
                        app:hintTextAppearance="@style/itemEdittextHintTxtAppearance"
                        app:mdShowDropdown="false">

                        <com.charm.phr.mphr.ui.components.MDTextInputEdittext
                            android:id="@+id/addVaccineDateET"
                            style="@style/itemTextInputEdittextTheme"
                            android:drawableEnd="@drawable/ic_calander"
                            android:hint="@string/procedure_date_hint" />

                    </com.charm.phr.mphr.ui.components.MDTextInputLayout>


                    <com.charm.phr.mphr.ui.components.MDTextInputLayout
                        android:id="@+id/addVaccineAdministeredListLayout"
                        style="@style/itemTextInputLayoutTheme"
                        app:hintTextAppearance="@style/itemEdittextHintTxtAppearance">

                        <com.charm.phr.mphr.ui.components.MDClickToSelectEdittext
                            android:id="@+id/addVaccineAdministeredListET"
                            style="@style/itemTextInputEdittextTheme"
                            android:hint="@string/vaccine_administered_list_str"
                            app:allowAutoSelect="true" />

                    </com.charm.phr.mphr.ui.components.MDTextInputLayout>


                    <com.google.android.material.textfield.TextInputLayout

                        android:id="@+id/addVaccineMemberNameLayout"
                        style="@style/itemTextInputLayoutTheme"
                        app:hintTextAppearance="@style/itemEdittextHintTxtAppearance"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent">

                        <com.charm.phr.mphr.ui.components.MDTextInputAutoCompleteTextView
                            android:id="@+id/addVaccineMemberNameET"
                            style="@style/itemTextInputEdittextTheme"
                            android:dropDownAnchor="@id/addVaccineMemberNameLayout"
                            android:hint="@string/vaccine_provider_label"
                            android:maxLength="@integer/addVaccineMemberNameMaxLength"

                            />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/addVaccineCommentsLayout"
                        style="@style/itemTextInputLayoutTheme"
                        android:layout_height="wrap_content"
                        android:minHeight="@dimen/textinput_edittext_height"
                        app:hintTextAppearance="@style/itemEdittextHintTxtAppearance">

                        <com.charm.phr.mphr.ui.components.MDTextInputEdittext
                            android:id="@+id/addVaccineCommentsET"
                            style="@style/itemTextInputEdittextMultiLineTheme"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="@string/vaccine_comments_str"
                            android:maxLength="@integer/addVaccineCommentsMaxLength" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
            </ScrollView>


            <Button
                style="@style/mdButtonStyle"
                android:id="@+id/addVaccineBtn"
                android:layout_width="match_parent"
                android:layout_height="@dimen/add_button_height"
                android:layout_margin="@dimen/button_margin"
                android:background="@drawable/item_button_bg"
                android:fontFamily="@font/open_sans_medium"
                android:text="@string/vaccine_add_str"
                android:textColor="@android:color/white"
                android:textSize="@dimen/large"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>


    </androidx.constraintlayout.widget.ConstraintLayout>


</androidx.constraintlayout.widget.ConstraintLayout>