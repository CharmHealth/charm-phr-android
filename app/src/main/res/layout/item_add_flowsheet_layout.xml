<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/addFlowsheetDataEntryCV"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/questionnaire_card_margin_horizontal"
    android:layout_marginTop="@dimen/questionnaire_card_margin_vertical"
    android:layout_marginBottom="@dimen/questionnaire_card_margin_vertical"
    android:layout_marginEnd="@dimen/questionnaire_card_margin_horizontal"
    app:cardCornerRadius="@dimen/common_card_radius"
    app:cardElevation="@dimen/common_card_elevation"
    >

    <LinearLayout
        android:id="@+id/addFlowsheetDataEntryLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/addFlowsheetDataHeadingTV"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/card_padding"
            android:fontFamily="@font/open_sans_medium"
            android:textColor="@color/black87"
            android:textSize="@dimen/medium"
            tools:text="Text" />

        <View
            android:id="@+id/addFlowsheetDataView"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/separatorColor" />
    </LinearLayout>

</androidx.cardview.widget.CardView>