        <attr name="mdCornerRadius" format="dimension" />
    </declare-styleable>

    <declare-styleable name="MDTextInputEdittext">

        <attr name="filterRegex" format="enum">
            <enum name="alphabets" value="1" />
            <enum name="alphabetsNumbers" value="2" />
            <enum name="alphabetsNumbersAndSplChar" value="3" />
            <enum name="number" value="4" />
            <enum name="passport" value="5" />
            <enum name="address" value="6" />
            <enum name="numberDecimal" value="7" />
        </attr>
        <attr name="setBgTransparent" format="boolean" />
    </declare-styleable>

    <declare-styleable name="MDTextInputLayout">
        <attr name="mdShowDropdown" format="boolean" />
        <attr name="mdShowLine" format="boolean" />

        <attr name="mdVerticalSpacing" format="float" />
        <attr name="mdEndSpacing" format="float" />

    </declare-styleable>

    <declare-styleable name="IconSwitch">
        <attr name="md_icon_left" format="reference" />
        <attr name="md_icon_right" format="reference" />
        <attr name="md_icon_size" format="dimension" />
        <attr name="md_background_color" format="color" />
        <attr name="md_thumb_color_left" format="color" />
        <attr name="md_thumb_color_right" format="color" />
        <attr name="md_inactive_tint_icon_left" format="color" />
        <attr name="md_inactive_tint_icon_right" format="color" />
        <attr name="md_active_tint_icon_left" format="color" />
        <attr name="md_active_tint_icon_right" format="color" />
        <attr name="md_default_selection" format="enum">
            <enum name="left" value="0" />
            <enum name="right" value="1" />
        </attr>
    </declare-styleable>

    <declare-styleable name="MDImageView">
        <attr name="mdImageViewRadius" format="dimension" />
    </declare-styleable>

    <declare-styleable name="CircleView">
        <attr name="circleViewBgColor" format="color" />
        <attr name="isColorVisible" format="boolean" />
        <attr name="text" format="string" />
        <attr name="textViewColor" format="color" />
        <attr name="textViewSize" format="dimension" />
        <attr name="textFamily" format="string" />
    </declare-styleable>


    <declare-styleable name="MDClickToSelectEdittext">
        <attr name="allowAutoSelect" format="boolean" />
        <attr name="showEmptyField" format="boolean" />
        <attr name="showSelectDivider"/>
        <attr name="showIcon" />
    </declare-styleable>
    <declare-styleable name="MDMultiClickToSelectEdittext">
        <attr name="showIcon" />
