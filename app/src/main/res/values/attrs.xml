<?xml version="1.0" encoding="utf-8"?>
<resources>

    <attr name="showIcon" format="boolean" />
    <attr name="showSelectDivider" format="boolean" />

    <declare-styleable name="MDmPHRConstraintLayout">
        <attr name="mdStrokeColor" format="color" />
