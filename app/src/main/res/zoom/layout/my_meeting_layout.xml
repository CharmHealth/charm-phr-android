<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    android:orientation="vertical">

    <include
        layout="@layout/zm_sdk_new_meeting_layout"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/mdZoomBottomLayout"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/mdLeaveZoomMeetingBtn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_margin="@dimen/zm_video_call_float_side_margin"
        android:elevation="@dimen/zm_fab_elevation"
        android:src="@drawable/ic_end_phone_call_24"
        app:backgroundTint="@color/endCallColor"
        app:layout_constraintBottom_toTopOf="@+id/mdZoomBottomLayout"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

    </com.google.android.material.floatingactionbutton.FloatingActionButton>

    <LinearLayout
        android:id="@+id/mdZoomBottomLayout"
        android:layout_width="match_parent"
        android:layout_height="@dimen/zm_action_button_height"
        android:background="@color/black30"
        android:orientation="horizontal"
        android:paddingBottom="@dimen/zm_common_card_padding"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:id="@+id/mdSwitchCameraLayout"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/mdSwitchCameraIv"
                android:layout_width="@dimen/zm_camera_flash_icon_size"
                android:layout_height="@dimen/zm_camera_flash_icon_size"
                android:background="@drawable/ic_camera_switch_solid_white"
                android:duplicateParentState="true"
                android:elevation="@dimen/zm_fab_elevation"
                android:focusable="false" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/mdVideoLayout"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/mdVideoIV"
                android:layout_width="@dimen/zm_camera_flash_icon_size"
                android:layout_height="@dimen/zm_camera_flash_icon_size"
                android:background="@drawable/ic_videocam_off_white_24dp"
                android:duplicateParentState="true"
                android:elevation="@dimen/zm_fab_elevation"
                android:focusable="false" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/mdAudioLayout"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/mdAudioIv"
                android:layout_width="@dimen/zm_camera_flash_icon_size"
                android:layout_height="@dimen/zm_camera_flash_icon_size"
                android:background="@drawable/ic_mic_off_white_solid_24"
                android:duplicateParentState="true"
                android:elevation="@dimen/zm_fab_elevation"
                android:focusable="false" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/mdParticipantsLayout"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/mdParticipantsIv"
                android:layout_width="@dimen/zm_camera_flash_icon_size"
                android:layout_height="@dimen/zm_camera_flash_icon_size"
                android:background="@drawable/ic_participants_sold_white_24"
                android:duplicateParentState="true"
                android:elevation="@dimen/zm_fab_elevation"
                android:focusable="false" />

        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>